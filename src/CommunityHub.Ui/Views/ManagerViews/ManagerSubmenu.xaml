<UserControl x:Class="CommunityHub.Ui.Views.ManagerSubmenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BottomNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource BottomNavBtn}" Click="Refresh_Click">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🏢" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Buildings" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource BottomNavBtn}" Click="ManageBuildingRequestsButton_Click">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Membership req." FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource BottomNavBtn}" Click="RentalRequestsButton_Click">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Rental req." FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Style="{StaticResource BottomNavBtn}" Click="AssembliesButton_Click">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Assemblies" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
