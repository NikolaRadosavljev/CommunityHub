<Page x:Class="CommunityHub.Ui.Views.ManagerHomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views"
        Title="Buildings"
        Background="#EAEAEA">
    
    <Page.Resources>
        <Style x:Key="BottomNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- MAIN SCROLL -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel Margin="15">

                <!-- STATS ROW -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="Black" BorderThickness="1,1,1,1" Padding="5,10" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonUp="StatMembership_Click">
                        <StackPanel>
                            <TextBlock x:Name="TxtBuildingCount" Text="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Membership req." FontSize="9" Foreground="Black" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" BorderBrush="Black" BorderThickness="1,1,1,1" Padding="5,10" Margin="2,0,2,0" Cursor="Hand" MouseLeftButtonUp="StatRental_Click">
                        <StackPanel>
                            <TextBlock x:Name="TxtRequestsCount" Text="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Rental req." FontSize="9" Foreground="Black" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="Black" BorderThickness="1,1,1,1" Padding="5,10" Margin="2,0,2,0" Cursor="Hand" MouseLeftButtonUp="StatAssemblies_Click">
                        <StackPanel>
                            <TextBlock x:Name="TxtAssembliesCount" Text="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Assemblies" FontSize="9" Foreground="Black" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="White" BorderBrush="Black" BorderThickness="1,1,1,1" Padding="5,10" Margin="2,0,0,0" Cursor="Hand" MouseLeftButtonUp="StatProblems_Click">
                        <StackPanel>
                            <TextBlock x:Name="TxtProblemsCount" Text="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Problems" FontSize="9" Foreground="Black" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Content="+ Register new building"
                        Style="{StaticResource ActionButton}"
                        Padding="15,12"
                        FontSize="14"
                        Margin="0,0,0,20"
                        Click="RegisterBuildingButton_Click"/>

                <!-- BUILDINGS LIST -->
                <ItemsControl x:Name="BuildingsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="Black" BorderThickness="1" Margin="0,0,0,15" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="🏢" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Address}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding StatusColor}" Padding="8,4" CornerRadius="2">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <UniformGrid Columns="4" Margin="0,0,0,15">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Settlement" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Settlement}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="City" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding City}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="FloorNumber" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding FloorNumber}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Number of Flats" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding NumberOfFlats}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,5">
                                            <Button Content="Memberships" Height="50" Tag="{Binding Id}" Click="OpenMemberships_Click" Background="White" BorderBrush="Black" BorderThickness="1" Padding="10,5" FontSize="11" FontWeight="Bold" Margin="0,0,5,0"/>
                                            <Button Content="Common rooms" Height="50" Tag="{Binding Id}" Click="OpenCommonRooms_Click" Background="White" BorderBrush="Black" BorderThickness="1" Padding="10,5" FontSize="11" FontWeight="Bold" Margin="0,0,5,0"/>
                                            <Button Content="Bulletin board" Height="50" Tag="{Binding Id}" Click="OpenBulletinBoard_Click" Background="White" BorderBrush="Black" BorderThickness="1" Padding="10,5" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1">
                                            <Button Content="+ Assembly" Height="50" Tag="{Binding Id}" Click="OpenAssemblies_Click" Background="White" BorderBrush="Black" BorderThickness="1" Padding="10,5" FontSize="11" FontWeight="Bold" Margin="0,0,5,0"/>
                                            <Button Content="Problems" Height="50" Tag="{Binding Id}" Click="OpenProblems_Click" Background="White" BorderBrush="Black" BorderThickness="1" Padding="10,5" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>