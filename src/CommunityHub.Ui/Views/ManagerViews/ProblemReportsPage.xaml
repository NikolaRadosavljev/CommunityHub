<Page x:Class="CommunityHub.Ui.Views.ManagerViews.ProblemReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      d:DesignHeight="750" d:DesignWidth="430"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Problem Reports">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Grid Grid.Row="0" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CbStatusFilter" Grid.Column="0" Margin="0,0,4,0" Height="28" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Status" IsSelected="True"/>
                <ComboBoxItem Content="Unresolved"/>
                <ComboBoxItem Content="Potentially Resolved"/>
                <ComboBoxItem Content="Resolved"/>
            </ComboBox>
            <ComboBox x:Name="CbPriorityFilter" Grid.Column="1" Margin="4,0,0,0" Height="28" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Priority" IsSelected="True"/>
                <ComboBoxItem Content="Urgent"/>
                <ComboBoxItem Content="Resolve Soon"/>
                <ComboBoxItem Content="Can Wait"/>
            </ComboBox>
        </Grid>

        <!-- Problems list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12">
            <StackPanel x:Name="SpProblems" Orientation="Vertical">
                <TextBlock x:Name="TbEmpty" Text="No problems reported."
                           FontSize="12" FontStyle="Italic" HorizontalAlignment="Center"
                           Margin="0,20,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
