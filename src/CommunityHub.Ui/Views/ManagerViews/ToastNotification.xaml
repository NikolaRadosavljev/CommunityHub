<UserControl x:Class="CommunityHub.Ui.Views.ManagerViews.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="12,12,12,0"
             Visibility="Collapsed">
    <Border x:Name="ToastBorder" CornerRadius="6" MinWidth="280" MaxWidth="380" Padding="14,10,10,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock x:Name="TbIcon" Grid.Column="0" Text="✓" FontSize="22" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <!-- Text -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TbTitle" Text="Success" FontSize="14" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="TbMessage" Text="" FontSize="12" Foreground="White" TextWrapping="Wrap"
                           Opacity="0.95" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Close button -->
            <Button x:Name="BtnClose" Grid.Column="2" Content="✕" FontSize="14" FontWeight="Bold"
                    Foreground="White" Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Cursor="Hand" Padding="6,2" Margin="4,0,0,0"
                    Click="BtnClose_Click"/>
        </Grid>
    </Border>
</UserControl>
