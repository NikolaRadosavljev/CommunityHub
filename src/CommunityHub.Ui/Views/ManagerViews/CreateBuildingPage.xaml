<Page x:Class="CommunityHub.Ui.Views.CreateBuildingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Building Registration"
        Background="#EAEAEA">

    <Page.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE 1 -->
        <Grid x:Name="Page1Grid" Grid.Row="0" Margin="15" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <TextBlock Text="Address and number" Style="{StaticResource InputLabel}"/>
                    <TextBox x:Name="AddressTextBox" Style="{StaticResource InputBox}"/>

                    <TextBlock Text="Settlement" Style="{StaticResource InputLabel}"/>
                    <TextBox x:Name="SettlementTextBox" Style="{StaticResource InputBox}"/>

                    <TextBlock Text="Country" Style="{StaticResource InputLabel}"/>
                    <ComboBox x:Name="CountryComboBox" Style="{StaticResource InputBox}" DisplayMemberPath="Name" SelectionChanged="CountryComboBox_SelectionChanged"/>

                    <TextBlock Text="City" Style="{StaticResource InputLabel}"/>
                    <ComboBox x:Name="CityComboBox" Style="{StaticResource InputBox}" DisplayMemberPath="Name"/>

                    <TextBlock Text="Number of floors" Style="{StaticResource InputLabel}"/>
                    <TextBox x:Name="FloorCountTextBox" Style="{StaticResource InputBox}"/>

                    <Grid Margin="0,15,0,5">
                        <TextBlock Text="Images" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Add Image" HorizontalAlignment="Right" Background="White" BorderBrush="Black" BorderThickness="1" Padding="5,2" FontWeight="SemiBold" Click="SelectImagesButton_Click"/>
                    </Grid>

                    <ItemsControl x:Name="ImagesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,10,10" Width="60" Height="60" Background="LightGray">
                                    <Grid>
                                        <Image Source="{Binding}" Stretch="UniformToFill"/>
                                        <Button Content="X" Tag="{Binding}" Background="#80FFFFFF" BorderThickness="0" FontWeight="Bold" Foreground="Black" Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Click="RemoveImage_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ValidationErrorTextBlock" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1" Content="Next page »" Style="{StaticResource ActionButton}" Click="NextPage_Click" Margin="0"/>
        </Grid>

        <!-- PAGE 2 -->
        <Grid x:Name="Page2Grid" Grid.Row="0" Margin="15" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" Margin="0,0,0,15">
                <StackPanel>
                    <ItemsControl x:Name="FloorsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,0,15" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Number of flats" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding FlatCount, UpdateSourceTrigger=PropertyChanged}" Width="40" Height="30" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="Black" BorderThickness="1" Margin="0,0,15,0" FontWeight="Bold" FontSize="16"/>
                                            <Button Content="+" Width="30" Height="30" FontSize="18" FontWeight="Bold" BorderBrush="Black" Background="LightGray" BorderThickness="1" Tag="{Binding}" Click="IncreaseFlatCount_Click" Margin="0,0,5,0"/>
                                            <Button Content="-" Width="30" Height="30" FontSize="18" FontWeight="Bold" BorderBrush="Black" Background="LightGray" BorderThickness="1" Tag="{Binding}" Click="DecreaseFlatCount_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Finish Registration" Background="White" Foreground="Black" BorderBrush="Black" BorderThickness="1" FontWeight="Bold" Padding="15" Margin="0,0,0,15" Click="FinishRegistration_Click"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1" Content="« Previous page" Style="{StaticResource ActionButton}" Click="PreviousPage_Click" Margin="0"/>
        </Grid>

    </Grid>
</Page>
