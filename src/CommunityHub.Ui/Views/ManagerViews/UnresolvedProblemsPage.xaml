<Page x:Class="CommunityHub.Ui.Views.ManagerViews.UnresolvedProblemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      d:DesignHeight="750" d:DesignWidth="430"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Unresolved Problems">

    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,12,12,12">
            <StackPanel x:Name="SpProblems" Orientation="Vertical">
                <TextBlock x:Name="TbEmpty" Text="No unresolved problems."
                           FontSize="12" FontStyle="Italic" HorizontalAlignment="Center"
                           Margin="0,20,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
