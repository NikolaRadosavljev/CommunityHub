<Page x:Class="CommunityHub.Ui.Views.AddCommonSpacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Common Room"
      Background="#EAEAEA">
    <Page.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>
        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="35"/>
        </Style>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Name" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="NameTextBox" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Description" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="DescriptionTextBox" Style="{StaticResource InputBox}"
                         Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="Floor Number" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="FloorNumberTextBox" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Rental Period" Style="{StaticResource InputLabel}" Margin="0,20,0,10"/>
                <RadioButton x:Name="OneDayRadioButton" Content="One day" Margin="0,0,0,10"/>
                <RadioButton x:Name="MoreDaysRadioButton" Content="More days"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Content="Finish Adding"
                Style="{StaticResource ActionButton}"
                Click="FinishAdding_Click"/>
    </Grid>
</Page>
