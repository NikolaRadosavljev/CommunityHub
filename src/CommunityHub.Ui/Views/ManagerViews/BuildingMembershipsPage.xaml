<Page x:Class="CommunityHub.Ui.Views.BuildingMembershipsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views"
        Title="Memberships"
        Background="#EAEAEA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SCROLLABLE LIST -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" Margin="15" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <ItemsControl x:Name="MembershipsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="Black" BorderThickness="1" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding TenantName}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Flat number:" FontSize="10" Margin="0,0,0,2"/>
                                        <Border BorderBrush="Black" BorderThickness="1" Height="25" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding FlatNumber}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Floor number:" FontSize="10" Margin="0,0,0,2"/>
                                        <Border BorderBrush="Black" BorderThickness="1" Height="25" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding FloorNumber}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Date:" FontSize="10" Margin="0,0,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border BorderBrush="Black" BorderThickness="1" Height="25" Margin="0,0,5,0">
                                                <TextBlock Text="{Binding JoinedAt, StringFormat='dd/MM/yyyy'}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                                            </Border>
                                            <!-- Calendar icon placeholder -->
                                            <TextBlock Grid.Column="1" Text="📅" FontSize="18" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
