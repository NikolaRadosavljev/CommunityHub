<Page x:Class="CommunityHub.Ui.Views.ManagerViews.Assemblies.AssemblyDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="750" d:DesignWidth="430"
      Title="Assembly Details">
    <Page.Resources>
        <Style x:Key="StatusBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,2"/>
        </Style>
    </Page.Resources>

    <Grid Background="White">
        <StackPanel Margin="12,12,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TbBuilding" Text="Building" FontWeight="SemiBold" FontSize="18" Grid.Column="0" />
                <Border Style="{StaticResource StatusBorder}" Grid.Column="1">
                    <TextBlock Text="Status" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </Grid>
            
            <TextBlock x:Name="TbDateTime" Text="Date    |    Time" Margin="0,4,0,0" FontSize="12" />
            
            <TextBlock Text="Topics" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" />
            <TextBlock x:Name="TbTopics" Text="Topic, Topic, Topic" FontSize="14" TextWrapping="Wrap" />

            <!-- Using a Border mimicking a separator to give bold line from wireframe -->
            <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="0,12,0,12" />

            <TextBlock Text="Apartments Attendance:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
            <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SpAttendance" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>