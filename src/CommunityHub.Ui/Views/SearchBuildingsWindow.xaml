<Window x:Class="CommunityHub.Ui.Views.SearchBuildingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pretraga zgrada" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Pretraga" Grid.Row="0" Margin="0,0,0,10" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Adresa:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="AddressTextBox" Grid.Row="0" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Naselje:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="SettlementTextBox" Grid.Row="0" Grid.Column="3" Margin="5"/>

                <TextBlock Text="Grad:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="CityTextBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Država:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="CountryTextBox" Grid.Row="1" Grid.Column="3" Margin="5"/>

                <Button Content="Pretraži" Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Width="80" Margin="5" Click="SearchButton_Click"/>
            </Grid>
        </GroupBox>

        <ListView x:Name="BuildingsListView" Grid.Row="1" Margin="0,0,0,10" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Slike" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding FirstPicture}" Width="50" Height="50" Stretch="UniformToFill"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Adresa" DisplayMemberBinding="{Binding Address}" Width="150"/>
                    <GridViewColumn Header="Naselje" DisplayMemberBinding="{Binding Settlement}" Width="150"/>
                    <GridViewColumn Header="Grad, Država" DisplayMemberBinding="{Binding Location}" Width="150"/>
                    <GridViewColumn Header="Spratovi" DisplayMemberBinding="{Binding FloorNumber}" Width="70"/>
                    <GridViewColumn Header="Ukupno stanova" DisplayMemberBinding="{Binding FlatsCount}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button Content="Nazad na početnu" Width="120" Click="BackButton_Click" Padding="5"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <Button Content="Podnesi zahtev za pristup" Width="160" Click="JoinButton_Click" Padding="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>