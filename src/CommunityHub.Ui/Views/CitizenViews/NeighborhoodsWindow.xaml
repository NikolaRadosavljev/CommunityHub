<Window x:Class="CommunityHub.Ui.Views.CitizenViews.NeighborhoodsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Neighborhood - Neighborhoods" Height="750" Width="1100" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFF6FF" Offset="0.0"/>
            <GradientStop Color="#E0E7FF" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BaseBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Content="← Back" Command="{Binding BackCommand}" Padding="16,10"/>
                <TextBlock Text="Neighborhood Search" FontSize="36" FontWeight="Bold" Foreground="#111827" Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="💡 Tutorial" Command="{Binding NavigateTutorialCommand}" Margin="0,0,12,0" Padding="16,10"/>
                <Button Content="📋 My Requests" Command="{Binding ViewRequestsCommand}" Padding="16,10"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#93C5FD" BorderThickness="4" Background="White" Padding="24" CornerRadius="16" Margin="0,0,25,0" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Color="#6B7280" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Neighborhood Name" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                    <TextBlock Text="Address" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding AddressFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                    <TextBlock Text="City" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding Cities}" 
                              SelectedItem="{Binding SelectedCity}" 
                              DisplayMemberPath="Name" 
                              Margin="0,0,0,18" 
                              Height="50"
                              FontSize="20" 
                              FontWeight="SemiBold"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <TextBlock Text="Country" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding Countries}" 
                              SelectedItem="{Binding SelectedCountry}" 
                              DisplayMemberPath="Name" 
                              Margin="0,0,0,28" 
                              Height="50"
                              FontSize="20" 
                              FontWeight="SemiBold"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <Button Content="🔍 Search" Command="{Binding SearchCommand}" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="18" Height="56"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
                <ItemsControl ItemsSource="{Binding Neighborhoods, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#BFDBFE" BorderThickness="4" Background="White" Margin="5,0,5,24" Padding="24" CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="#6B7280" Opacity="0.08"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="180" Height="180" CornerRadius="12" ClipToBounds="True" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="2" VerticalAlignment="Top">
                                        <Grid>
                                            <TextBlock Text="🏙️" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Images[0]}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                                        <TextBlock Text="{Binding Description, Mode=OneWay}" FontSize="16" Foreground="#4B5563" Margin="0,6,0,14" TextWrapping="Wrap" LineHeight="22"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="📍 Location: " FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                                            <TextBlock Text="{Binding City.Name}" FontSize="16" Foreground="#1F2937" FontWeight="SemiBold"/>
                                            <TextBlock Text=", " FontSize="16" Foreground="#1F2937" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding City.Country.Name}" FontSize="16" Foreground="#1F2937" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,20">
                                            <TextBlock Text="🗺 Streets:" FontSize="16" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Streets, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="12,3,0,0" FontSize="16" Foreground="#4B5563">
                                                            <Run Text="• "/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding StartNumber, Mode=OneWay}"/><Run Text="-"/><Run Text="{Binding EndNumber, Mode=OneWay}"/><Run Text=")"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Button Content="Request access to this neighborhood" 
                                                Command="{Binding DataContext.RequestAccessCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}" 
                                                Background="#16A34A" Foreground="White" BorderThickness="0" 
                                                HorizontalAlignment="Left" Padding="24,14" FontSize="16"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>