<Window x:Class="CommunityHub.Ui.Views.CitizenViews.EventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
        Title="My Neighborhood - Events" Height="750" Width="1050" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFF6FF" Offset="0.0"/>
            <GradientStop Color="#E0E7FF" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Content="← Back" Command="{Binding BackCommand}" Padding="16,10"/>
                <TextBlock Text="Events" FontSize="36" FontWeight="Bold" Foreground="#111827" Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="💡 Tutorial" Command="{Binding NavigateTutorialCommand}" Margin="0,0,12,0" Padding="16,10"/>
                <Button Content="Generate Report" Command="{Binding GenerateReportCommand}" Margin="0,0,12,0" Padding="16,10"/>
                <Button Content="➕ Create an event" Command="{Binding CreateEventCommand}" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="22,12" FontSize="16"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
            <ItemsControl ItemsSource="{Binding Events, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#BFDBFE" BorderThickness="4" Background="White" Margin="5,0,5,24" Padding="24" CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#6B7280" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Event.Name, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                                        <TextBlock Text="{Binding Event.Description, Mode=OneWay}" FontSize="16" Foreground="#4B5563" Margin="0,6,0,18" TextWrapping="Wrap" LineHeight="22"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="15,5,0,0">

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                            <TextBlock FontSize="20" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="❌"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAlreadyRegistered}" Value="True">
                                                                <Setter Property="Text" Value="✅"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="You are not registered."/>
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAlreadyRegistered}" Value="True">
                                                                <Setter Property="Text" Value="You are registered."/>
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,40,10">
                                        <TextBlock Text="📅 Date &amp; time: " FontWeight="Bold" Foreground="#1F2937" FontSize="15"/>
                                        <TextBlock Text="{Binding Event.Date, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}" FontSize="15" Foreground="#4B5563" FontWeight="SemiBold"/>
                                        <TextBlock Text=" / " FontSize="15" Foreground="#4B5563" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Event.StartTime, StringFormat={}{0:HH\\:mm}, Mode=OneWay}" FontSize="15" Foreground="#4B5563" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,40,10">
                                        <TextBlock Text="🕒 Duration: " FontWeight="Bold" Foreground="#1F2937" FontSize="15"/>
                                        <TextBlock Text="{Binding Event.DurationMinutes, Mode=OneWay}" FontSize="15" Foreground="#4B5563" FontWeight="SemiBold"/>
                                        <TextBlock Text=" mins" FontSize="15" Foreground="#4B5563" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,40,10">
                                        <TextBlock Text="👥 Volunteers: " FontWeight="Bold" Foreground="#1F2937" FontSize="15"/>
                                        <TextBlock Text="{Binding Event.CurrentVolunteerCount, Mode=OneWay}" FontSize="15" Foreground="#4B5563" FontWeight="SemiBold"/>
                                        <TextBlock Text=" / " FontSize="15" Foreground="#4B5563" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Event.MinVolunteers, Mode=OneWay}" FontSize="15" Foreground="#4B5563" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,40,10">
                                        <TextBlock Text="📢 Status: " FontWeight="Bold" Foreground="#1F2937" FontSize="15"/>
                                        <TextBlock Text="{Binding Event.Status, Mode=OneWay}" FontSize="15" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Event.Status}" Value="Active">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Event.Status}" Value="Cancelled">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Event.Status}" Value="Completed">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <TextBlock Text="Required things: " FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="15"/>
                                    <ItemsControl ItemsSource="{Binding Event.Items, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="2" CornerRadius="8" Padding="12,6" Margin="0,4,8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="14" Foreground="#111827" FontWeight="Bold"/>
                                                        <TextBlock Text=" (" FontSize="13" Foreground="#4B5563"/>
                                                        <TextBlock Text="{Binding IsCovered, Converter={StaticResource BoolToStatusConverter}, Mode=OneWay}" FontSize="13" Foreground="#4B5563" FontWeight="SemiBold"/>
                                                        <TextBlock Text=")" FontSize="13" Foreground="#4B5563"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Button Content="Register for the event"
                                        Command="{Binding DataContext.RegisterVolunteerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Event}"
                                        Padding="24,16" FontSize="16" FontWeight="Bold" HorizontalAlignment="Stretch" Background="#16A34A" Foreground="White" BorderThickness="0"
                                        Visibility="{Binding CanRegisterVolunteerForUser, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding CanRegisterVolunteerForUser}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>