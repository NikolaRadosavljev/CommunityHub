<Window x:Class="CommunityHub.Ui.Views.CitizenViews.NeighborhoodMembershipRequestViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Requests for Access" Height="650" Width="750"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFF6FF" Offset="0.0"/>
            <GradientStop Color="#E0E7FF" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#111827"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#111827"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#111827"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Height" Value="42"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Button Content="❌ Close" Command="{Binding CloseWindowCommand}" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Text="My requests for neighborhood access" FontSize="26" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,0,25">
            <TextBlock Text="Filter by Status:" FontSize="15" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Width="140" SelectedValuePath="Content" SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Approved"/>
                <ComboBoxItem Content="Rejected"/>
            </ComboBox>

            <TextBlock Text="Sort:" FontSize="15" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center" Margin="30,0,10,0"/>
            <ComboBox Width="160" SelectedValuePath="Content" SelectedValue="{Binding SelectedSortOrder, Mode=TwoWay}">
                <ComboBoxItem Content="Newest First"/>
                <ComboBoxItem Content="Oldest First"/>
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
            <ItemsControl ItemsSource="{Binding FilteredRequests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#111827" BorderThickness="3" Background="White" Margin="5,0,5,20" Padding="24" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="0" ShadowDepth="4" Direction="315" Color="#111827" Opacity="0.15"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,5">
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8">
                                        <Run Text="Neighborhood: " Foreground="#4B5563" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Neighborhood.Name, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="15" Foreground="#111827" Margin="0,0,0,6">
                                        <Run Text="Date and Time: " Foreground="#4B5563"/>
                                        <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:dd. MM. yyyy. HH:mm}}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="15" Foreground="#111827" x:Name="TxtStatus" Margin="0,0,0,4">
                                        <Run Text="Status: " Foreground="#4B5563"/>
                                        <Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="15" Foreground="#DC2626" x:Name="TxtRejection" Visibility="Collapsed" Margin="0,4,0,4">
                                        <Run Text="Rejection reason: " FontWeight="Bold"/>
                                        <Run Text="{Binding RejectionReason, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Row="1" x:Name="BtnCancel" Content="Cancel Request" 
                                        Command="{Binding DataContext.CancelRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource CancelButtonStyle}" 
                                        Margin="0,10,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                <Setter TargetName="TxtRejection" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TxtStatus" Property="Foreground" Value="#DC2626"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                <Setter TargetName="TxtStatus" Property="Foreground" Value="#16A34A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                <Setter TargetName="BtnCancel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TxtStatus" Property="Foreground" Value="#D97706"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>