<Window x:Class="CommunityHub.Ui.Views.CitizenViews.CitizenHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Neighborhood - Home" Height="650" Width="950" 
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ResizeMode="NoResize">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFF6FF" Offset="0.0"/>
            <GradientStop Color="#E0E7FF" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#111827"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#111827"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="0" ShadowDepth="4" Direction="315" Color="#111827" Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="35,30,35,35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Welcome, Ana" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="📍 Your Neighborhood: " FontSize="14" FontWeight="Medium" Foreground="#4B5563"/>
                    <TextBlock Text="Liman" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="💡 Tutorial" Command="{Binding NavigateTutorialCommand}" Style="{StaticResource NavButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="👤 My Profile" Command="{Binding NavigateProfileCommand}" Style="{StaticResource NavButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="⤶ Log out" Command="{Binding LogoutCommand}" Style="{StaticResource NavButtonStyle}" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#DC2626"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Rows="2">

            <Button Command="{Binding NavigateNeighborhoodsCommand}" Style="{StaticResource MenuTileButtonStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🏢" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Neighborhoods" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding NavigateEventsCommand}" Style="{StaticResource MenuTileButtonStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📅" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Events" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding NavigateMeetingsCommand}" Style="{StaticResource MenuTileButtonStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="☑" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Meetings" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding NavigateFacilitiesCommand}" Style="{StaticResource MenuTileButtonStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📍" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="City Facilities" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding NavigateRatingsCommand}" Style="{StaticResource MenuTileButtonStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⭐" FontSize="75" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Coordinator Ratings" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding NavigateDonationsCommand}" Style="{StaticResource MenuTileButtonStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="💖" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Donations" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

        </UniformGrid>
    </Grid>
</Window>