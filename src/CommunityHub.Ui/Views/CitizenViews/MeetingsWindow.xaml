<Window x:Class="CommunityHub.Ui.Views.CitizenViews.MeetingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Neighborhood Meetings" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFF6FF" Offset="0.0"/>
            <GradientStop Color="#E0E7FF" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BaseBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Command="{Binding BackCommand}" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 8,0 L 0,4 L 8,8 M 0,4 L 14,4" Stroke="#1F2937" StrokeThickness="2.5" VerticalAlignment="Center" Margin="0,1,8,0" Width="14" Height="9" Stretch="Fill"/>
                        <TextBlock Text="Back" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Neighborhood Meetings" FontSize="36" FontWeight="Bold" Foreground="#111827" Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
            <ItemsControl ItemsSource="{Binding Meetings}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#BFDBFE" BorderThickness="4" Background="White" Margin="5,0,5,24" Padding="24" CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="#6B7280" Opacity="0.08"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Top" Width="48" Height="48">
                                    <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,11H12V16H17V11Z" 
                                          Fill="#2563EB" Stretch="Fill"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12">
                                        <Run Text="Topic: " Foreground="#475569" FontWeight="Medium"/>
                                        <Run Text="{Binding Topic, Mode=OneWay}"/>
                                    </TextBlock>

                                    <UniformGrid Columns="3" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Time" FontSize="13" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Time, Mode=OneWay}" FontSize="16" Foreground="#111827" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Current Status" FontSize="13" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Status, Mode=OneWay}" FontSize="16" Foreground="#2563EB" FontWeight="Bold"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <Separator Background="#E2E8F0" Margin="0,0,0,16"/>

                                    <StackPanel x:Name="PreparationPanel" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Voting Window:" FontSize="15" FontWeight="SemiBold" Foreground="#475569"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Meeting.StartDate, Mode=OneWay, StringFormat={}{0:dd. MM. yyyy.}}" FontSize="15" Foreground="#111827" FontWeight="Bold"/>
                                                <TextBlock Text="  to  " FontSize="15" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Meeting.EndDate, Mode=OneWay, StringFormat={}{0:dd. MM. yyyy.}}" FontSize="15" Foreground="#111827" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Your Casted Vote:" FontSize="15" FontWeight="SemiBold" Foreground="#475569"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VotedDateDisplay, Mode=OneWay}" FontSize="15" Foreground="#111827" FontWeight="Bold"/>
                                        </Grid>

                                        <Border x:Name="VotingInteractionPanel" Visibility="Collapsed" BorderBrush="#DBEAFE" BorderThickness="2" Background="#F8FAFC" Padding="16" CornerRadius="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Select your preferred date choice:" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <DatePicker Grid.Column="0" SelectedDate="{Binding UISelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="44" VerticalContentAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                                        <Button x:Name="VoteBtn" Content="Submit Vote" Command="{Binding VoteCommand}" Padding="20,0" Height="44" Visibility="Collapsed"/>
                                                        <Button x:Name="ChangeVoteBtn" Content="Change Vote" Command="{Binding ChangeVoteCommand}" Padding="20,0" Height="44" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="ClosedDisclaimer" Text="Voting period has ended." Foreground="#DC2626" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <Border x:Name="ScheduledPanel" Visibility="Collapsed" BorderBrush="#A7F3D0" BorderThickness="2" Background="#ECFDF5" Padding="14" CornerRadius="12">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.58,8.08L11,13.67L7.92,10.59L6.5,12L11,16.5Z" 
                                                  Fill="#059669" Width="18" Height="18" Stretch="Fill" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Official Scheduled Date: " FontSize="15" Foreground="#065F46" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Meeting.ScheduledDate, Mode=OneWay, StringFormat={}{0:dd. MM. yyyy.}}" FontSize="16" Foreground="#047857" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInPreparation}" Value="True">
                                <Setter TargetName="PreparationPanel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsScheduled}" Value="True">
                                <Setter TargetName="ScheduledPanel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanVote}" Value="True">
                                <Setter TargetName="VotingInteractionPanel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CannotVote}" Value="True">
                                <Setter TargetName="ClosedDisclaimer" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasNotVoted}" Value="True">
                                <Setter TargetName="VoteBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasVoted}" Value="True">
                                <Setter TargetName="ChangeVoteBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>