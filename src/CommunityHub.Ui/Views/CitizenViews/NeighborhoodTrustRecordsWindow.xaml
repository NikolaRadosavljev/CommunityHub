<Window x:Class="CommunityHub.Ui.Views.NeighborhoodTrustRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="All Members" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="FigmaCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2" Padding="30,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding CloseCommand}" Style="{StaticResource FigmaCloseButtonStyle}" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M0,0 L14,14 M14,0 L0,14" Stroke="#0F172A" StrokeThickness="3" 
                              Width="14" Height="14" Stretch="Fill" VerticalAlignment="Center" Margin="0,1,12,0"/>
                        <TextBlock Text="Close" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="Members" FontSize="36" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,24">
            <ItemsControl ItemsSource="{Binding Records}" MaxWidth="880" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#0F172A" BorderThickness="2.5"
                                Background="#FFFFFF" Margin="0,0,0,16"
                                Padding="24,20" CornerRadius="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center" Width="42" Height="42">
                                    <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14M22,12A3,3 0 0,1 19,15A3,3 0 0,1 16,12A3,3 0 0,1 19,9A3,3 0 0,1 22,12M22,18V20H21V18C21,16.5 19.9,15.28 18.5,14.42C20.6,14.83 22,16.21 22,18Z" 
                                          Fill="#0F172A" Stretch="Fill"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName, Mode=OneWay}" 
                                               FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Member since: " FontSize="15" Foreground="#475569" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding JoinedDate, Mode=OneWay}" FontSize="15" Foreground="#0F172A" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Their level of trust: " FontSize="15" Foreground="#475569" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding TrustLevelName, Mode=OneWay}" FontSize="15" Foreground="#0F172A" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>