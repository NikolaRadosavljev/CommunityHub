<Window x:Class="CommunityHub.Ui.Views.CitizenViews.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="My Profile" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button Command="{Binding HomeCommand}" Style="{StaticResource ActionButtonStyle}" Padding="14,6" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 8,0 L 0,4 L 8,8 M 0,4 L 14,4" Stroke="#0F172A" StrokeThickness="2" VerticalAlignment="Center" Margin="0,1,8,0" Width="14" Height="9" Stretch="Fill"/>
                            <TextBlock Text="Back" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="My Profile" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="See all Members" Command="{Binding SeeMembersCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,12,0"/>
                    <Button Content="My Events" Command="{Binding MyEventsCommand}" Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,24">
            <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="72" Height="72" Margin="0,0,20,0" VerticalAlignment="Top">
                            <Ellipse Fill="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="2"/>
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                  Fill="#64748B" Width="36" Height="36" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FullName, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Address:" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Address, Mode=OneWay}" Grid.Row="0" Grid.Column="1" FontSize="15" Foreground="#334155" Margin="0,0,0,6"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="16" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,17L14.47,18.5L13.81,15.68L16,13.8L13.09,13.56L12,10.88L10.91,13.56L8,13.8L10.19,15.68L9.53,18.5L12,17Z" 
                                  Fill="#0F172A" Width="22" Height="22" Stretch="Fill" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Trust Record" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <UniformGrid Columns="2" Margin="0,0,0,20">
                            <Border BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,11H12V16H17V11Z" 
                                              Fill="#64748B" Width="16" Height="16" Stretch="Fill" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Events organized:" FontSize="14" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OrganizedCount, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z" 
                                              Fill="#64748B" Width="16" Height="16" Stretch="Fill" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Events where you volunteered:" FontSize="14" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding VolunteeredCount, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="#F1F5F9" CornerRadius="12" Padding="20,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Joined neighborhood on: " FontSize="14" Foreground="#475569"/>
                                    <TextBlock Text="{Binding JoinedDate, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                                <TextBlock Text="Your level:" FontSize="14" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding TrustLevelName, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>