<Window x:Class="CommunityHub.Ui.Views.CoordinatorViews.ForumsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forumi koordinatora"
        Height="750"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Forumi koordinatora"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Pretraga -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Naslov:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TitleSearchTextBox" Width="200" Margin="0,0,10,0"/>
            <TextBlock Text="Opis:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="DescriptionSearchTextBox" Width="200" Margin="0,0,10,0"/>
            <Button Content="Pretraži" Width="100" Margin="0,0,10,0"
                    Click="SearchButton_Click"/>
            <Button Content="Nazad" Width="100"
                    Click="BackButton_Click"/>
        </StackPanel>

        <!-- Kreiranje novog foruma -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Kreiraj novi forum"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Naslov:" Margin="0,0,0,5"/>
            <TextBox x:Name="NewTitleTextBox" Height="30" Margin="0,0,0,10"/>
            <TextBlock Text="Opis:" Margin="0,0,0,5"/>
            <TextBox x:Name="NewDescriptionTextBox"
                     Height="70"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,0,0,10"/>
            <Button Content="Kreiraj forum"
                    Width="150"
                    Height="35"
                    HorizontalAlignment="Left"
                    Click="CreateForumButton_Click"/>
        </StackPanel>

        <!-- Lista foruma -->
        <DataGrid x:Name="ForumsDataGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naslov"
                                    Binding="{Binding Title}"
                                    Width="250"/>
                <DataGridTextColumn Header="Opis"
                                    Binding="{Binding Description}"
                                    Width="400"/>
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="4"
                Content="Otvori forum"
                Width="150"
                Height="35"
                HorizontalAlignment="Left"
                Click="OpenForumButton_Click"/>
    </Grid>
</Window>