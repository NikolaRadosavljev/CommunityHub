<Window x:Class="CommunityHub.Ui.Views.CreateNeighborhoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registracija kvarta"
        Height="750"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Registracija kvarta"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Naziv" Margin="0,0,0,5"/>
                <TextBox x:Name="NameTextBox" Height="30"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Opis" Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionTextBox"
                         Height="90"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock Text="Grad" Margin="0,0,0,5"/>
                <ComboBox x:Name="CityComboBox"
                          Height="30"
                          DisplayMemberPath="Name"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,15">
                <TextBlock Text="Dodavanje ulica" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Naziv ulice" Margin="0,0,0,5"/>
                <TextBox x:Name="StreetNameTextBox" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Početni broj" Margin="0,0,0,5"/>
                <TextBox x:Name="StartNumberTextBox" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Krajnji broj" Margin="0,0,0,5"/>
                <TextBox x:Name="EndNumberTextBox" Height="30" Margin="0,0,0,10"/>

                <Button Content="Dodaj ulicu"
                        Width="120"
                        Height="35"
                        Margin="0,5,0,10"
                        HorizontalAlignment="Left"
                        Click="AddStreetButton_Click"/>

                <ListBox x:Name="StreetsListBox" Height="120"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,15">
                <TextBlock Text="Slike" Margin="0,0,0,5"/>

                <Button Content="Dodaj slike"
            Width="120"
            Height="35"
            Click="AddImagesButton_Click"/>

                <ListBox x:Name="ImagesListBox" Height="120"/>
            </StackPanel>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Sačuvaj"
                        Width="100"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>
                <Button Content="Nazad"
                        Width="100"
                        Height="35"
                        Click="BackButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>