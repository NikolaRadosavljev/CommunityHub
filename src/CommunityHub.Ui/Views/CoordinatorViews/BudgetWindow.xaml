<Window x:Class="CommunityHub.Ui.Views.CoordinatorViews.BudgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upravljanje budžetom"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Upravljanje budžetom"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Kvart selector -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Kvart:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="NeighborhoodComboBox" Width="200"
                      DisplayMemberPath="Name"
                      SelectionChanged="NeighborhoodComboBox_SelectionChanged"/>
            <Button Content="Nazad" Width="100" Margin="20,0,0,0"
                    Click="BackButton_Click"/>
        </StackPanel>

        <!-- Kategorije -->
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="Kategorije:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox x:Name="CategoriesListBox" Height="150"
                     SelectionChanged="CategoriesListBox_SelectionChanged"/>
        </StackPanel>

        <!-- Donacije -->
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock Text="Donacije za kategoriju:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DataGrid x:Name="DonationsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True" Height="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Iznos" Binding="{Binding Amount}" Width="100"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding DonatedAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Troškovi -->
        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="Istorija troškova:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DataGrid x:Name="ExpensesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Iznos" Binding="{Binding Amount}" Width="80"/>
                    <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding ExpenseDate}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Dodaj trošak -->
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock Text="Dodaj trošak:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Iznos:" Margin="0,0,0,5"/>
            <TextBox x:Name="ExpenseAmountTextBox" Height="32" Padding="8,5" Margin="0,0,0,10"/>
            <TextBlock Text="Opis:" Margin="0,0,0,5"/>
            <TextBox x:Name="ExpenseDescriptionTextBox" Height="60"
                     TextWrapping="Wrap" AcceptsReturn="True" Padding="8,5" Margin="0,0,0,10"/>
            <TextBlock Text="Datum troška:" Margin="0,0,0,5"/>
            <DatePicker x:Name="ExpenseDatePicker" Margin="0,0,0,10"/>
            <Button Content="Dodaj trošak" Height="35"
                    Background="#E74C3C" Foreground="White" BorderThickness="0"
                    Click="AddExpenseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>