<Window x:Class="CommunityHub.Ui.Views.NeighborhoodMembershipRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zahtevi za pristup kvartovima"
        Height="750"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Upravljanje zahtevima za pristup kvartovima"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">
            <TextBlock Text="Status:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox x:Name="StatusFilterComboBox"
                      Width="180"
                      Margin="0,0,10,0"/>

            <Button Content="Filtriraj"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="FilterButton_Click"/>

            <Button Content="Nazad"
                    Width="100"
                    Click="BackButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="RequestsDataGrid"
          Grid.Row="2"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          SelectionChanged="RequestsDataGrid_SelectionChanged"
          Margin="0,0,0,20">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#D6EAF8"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Građanin"
                            Binding="{Binding CitizenFullName}"
                            Width="180"/>
                <DataGridTextColumn Header="Adresa"
                            Binding="{Binding CitizenAddress}"
                            Width="220"/>
                <DataGridTextColumn Header="Kvart"
                            Binding="{Binding NeighborhoodName}"
                            Width="180"/>
                <DataGridTextColumn Header="Datum kreiranja"
                            Binding="{Binding CreatedAt}"
                            Width="160"/>
                <DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="120"/>
                <DataGridTextColumn Header="Obrazloženje"
                            Binding="{Binding RejectionReason}"
                            Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock x:Name="SelectedRequestTextBlock"
               Text="Nijedan zahtev nije izabran."
               FontSize="14"
               FontWeight="Bold"
               Foreground="#2C3E50"
               Margin="0,0,0,10"/>

            <TextBlock Text="Razlog odbijanja (unesite samo ako odbijate zahtev)"
               Margin="0,0,0,5"/>
            <TextBox x:Name="RejectionReasonTextBox"
             Height="70"
             TextWrapping="Wrap"
             AcceptsReturn="True"/>
        </StackPanel>

      

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,20">
            <Button Content="Odobri"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="ApproveButton_Click"/>
            <Button Content="Odbij"
                    Width="100"
                    Click="RejectButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <TextBlock Text="Članstva u kvartovima"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <DataGrid x:Name="MembershipsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Građanin"
                                        Binding="{Binding CitizenFullName}"
                                        Width="200"/>
                    <DataGridTextColumn Header="Adresa"
                                        Binding="{Binding CitizenAddress}"
                                        Width="250"/>
                    <DataGridTextColumn Header="Datum učlanjenja"
                                        Binding="{Binding JoinedAt}"
                                        Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>