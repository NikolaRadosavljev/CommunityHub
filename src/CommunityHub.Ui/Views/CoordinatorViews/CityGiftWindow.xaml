<Window x:Class="CommunityHub.Ui.Views.CoordinatorViews.CityGiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poklon grada"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Donacije — Poklon grada"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Kvart selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Prijavi se za kvart:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="NeighborhoodComboBox" Width="200"
                      DisplayMemberPath="Name"/>
            <Button Content="Nazad" Width="100" Margin="20,0,0,0"
                    Click="BackButton_Click"/>
        </StackPanel>

        <!-- Lista poklona -->
        <DataGrid Grid.Row="2"
                  x:Name="GiftsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Iznos" Binding="{Binding Amount}" Width="150"/>
                <DataGridTextColumn Header="Rok za prijavu" Binding="{Binding Deadline}" Width="200"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   Text="Napomena: Možete se prijaviti samo za jedan kvart po poklonu."
                   Foreground="Gray" FontSize="12" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Prijavi se"
                    Width="150" Height="35"
                    Background="#2C3E50" Foreground="White" BorderThickness="0"
                    Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>