<Window x:Class="CommunityHub.Ui.Views.CoordinatorViews.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommunityHub - Koordinator"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                Padding="25,18">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CommunityHub"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#2C3E50"/>
                    <TextBlock Text="Koordinator kvarta"
                               FontSize="13" Foreground="Gray"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button Click="LogoutButton_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="18,10"
                        Background="Transparent"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Cursor="Hand">
                    <TextBlock Text="Odjavi se" Foreground="#555" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Navigation bar -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                Padding="25,12">
            <WrapPanel>
                <Button Click="CreateNeighborhoodButton_Click"
                        Padding="18,12" Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="Registruj kvart" FontSize="14"/>
                </Button>

                <Button Click="NeighborhoodRequestsButton_Click"
                        Padding="18,12" Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="Zahtevi za kvartove" FontSize="14"/>
                </Button>

                <Button Click="CitizenStatisticsButton_Click"
                        Padding="18,12" Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="Statistika i sastanci" FontSize="14"/>
                </Button>

                <Button Click="ForumsButton_Click"
                        Padding="18,12" Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="Forumi" FontSize="14"/>
                </Button>

                <Button Click="CityObjectsButton_Click"
                        Padding="18,12" Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="Gradski objekti" FontSize="14"/>
                </Button>

                <Button Click="ReviewsButton_Click"
                        Padding="18,12" Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="Recenzije" FontSize="14"/>
                </Button>

                <Button Click="BudgetButton_Click"
                        Padding="18,12" Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="Budžet" FontSize="14"/>
                </Button>

                <Button Click="CityGiftButton_Click"
                        Padding="18,12" Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="Poklon grada" FontSize="14"/>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Dobrodošli!"
                       FontSize="32" FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
            <TextBlock Text="Odaberite sekciju iz navigacije iznad."
                       FontSize="16" Foreground="Gray"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>