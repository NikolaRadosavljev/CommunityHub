<Window x:Class="CommunityHub.Ui.Views.CoordinatorViews.CityObjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rezervacija gradskih objekata"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Rezervacija gradskih objekata"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Kvart selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Kvart:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="NeighborhoodComboBox"
                      Width="200"
                      DisplayMemberPath="Name"
                      SelectionChanged="NeighborhoodComboBox_SelectionChanged"/>
            <Button Content="Nazad" Width="100" Margin="20,0,0,0"
                    Click="BackButton_Click"/>
        </StackPanel>

        <!-- Gradski objekti -->
        <DataGrid Grid.Row="2"
                  x:Name="CityObjectsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="300"/>
                <DataGridTextColumn Header="Broj glasova" Binding="{Binding VoteCount}" Width="100"/>
                <DataGridTextColumn Header="Poslednja poseta" Binding="{Binding LastVisitDate}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Unos trajanja i opsega datuma -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Trajanje posete (minuti):" Margin="0,0,0,5"/>
            <TextBox x:Name="DurationTextBox" Width="200" Height="32"
                     HorizontalAlignment="Left" Padding="8,5"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Od:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="StartDatePicker" Width="150" Margin="0,0,15,0"/>
            <TextBlock Text="Do:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="EndDatePicker" Width="150" Margin="0,0,15,0"/>
            <Button Content="Pronađi termine" Width="150" Height="35"
                    Background="#2C3E50" Foreground="White" BorderThickness="0"
                    Click="FindSlotsButton_Click"/>
        </StackPanel>

        <!-- Slobodni termini -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock x:Name="SlotsLabelTextBlock"
                       Text="Slobodni termini:"
                       FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox x:Name="SlotsListBox" Height="120"/>
        </StackPanel>

        <!-- Dugme za rezervaciju -->
        <Button Grid.Row="6"
                Content="Rezerviši odabrani termin"
                Width="200" Height="35"
                HorizontalAlignment="Left"
                Background="#27AE60" Foreground="White" BorderThickness="0"
                Click="ReserveButton_Click"/>
    </Grid>
</Window>