<Window x:Class="CommunityHub.Ui.Views.TenantViews.CreateHelpAdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Your Ad"
        Height="800"
        Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#222" FontWeight="SemiBold"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Homeowners"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Margin="40" VerticalAlignment="Top">
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="←" Background="Transparent" Foreground="#666"
                            FontSize="24" BorderThickness="0" Padding="5" Cursor="Hand"
                            Click="BackButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Grid.Column="1" Text="Create your ad:"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#222222"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- FORM CONTAINER -->
                <Border Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="30">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: TYPE AND CATEGORY -->
                        <StackPanel Grid.Column="0" Margin="0,0,30,0" Width="150">
                            <!-- TYPE SELECTION -->
                            <TextBlock Text="Type"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,12"/>

                            <StackPanel Margin="0,0,0,30">
                                <RadioButton x:Name="RbOffering"
                                             Content="Offers"
                                             Margin="0,0,0,10"
                                             IsChecked="True"
                                             FontSize="13"/>
                                <RadioButton x:Name="RbSeeking"
                                             Content="Requests"
                                             FontSize="13"/>
                            </StackPanel>

                            <!-- CATEGORY -->
                            <TextBlock Text="Category"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8"/>

                            <ComboBox x:Name="CbCategory"
                                      Height="36"
                                      Padding="8,6"
                                      FontSize="13">
                                <ComboBoxItem>Moving</ComboBoxItem>
                                <ComboBoxItem>Repairs</ComboBoxItem>
                                <ComboBoxItem>Borrowing</ComboBoxItem>
                                <ComboBoxItem>Cleaning</ComboBoxItem>
                                <ComboBoxItem>Gardening</ComboBoxItem>
                                <ComboBoxItem>Other</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <!-- MIDDLE COLUMN: DESCRIPTION -->
                        <StackPanel Grid.Column="1" Margin="0,0,30,0">
                            <TextBlock Text="Add comment:"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="TxtDescription"
                                     Height="140"
                                     Padding="12,10"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"
                                     FontSize="13"
                                     AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- RIGHT COLUMN: DATE SELECTION -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Select dates:"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,15"/>

                            <!-- FROM DATE -->
                            <TextBlock Text="From:"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#666666"
                                       Margin="0,0,0,5"/>

                            <DatePicker x:Name="DpFromDate"
                                        Height="36"
                                        Padding="8"
                                        FontSize="12"
                                        Margin="0,0,0,15"/>

                            <!-- TO DATE -->
                            <TextBlock Text="To:"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#666666"
                                       Margin="0,0,0,5"/>

                            <DatePicker x:Name="DpToDate"
                                        Height="36"
                                        Padding="8"
                                        FontSize="12"
                                        Margin="0,0,0,20"/>

                            <!-- WORKING HOURS -->
                            <TextBlock Text="Working hours:"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#666666"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtStartTime"
                                         Grid.Column="0"
                                         Height="36"
                                         Padding="8"
                                         FontSize="12"
                                         BorderBrush="#CCCCCC"
                                         BorderThickness="1"
                                         Margin="0,0,8,0"
                                         Text="13:00"
                                         ToolTip="Start time (e.g., 13:00)"/>

                                <TextBlock Grid.Column="1"
                                           Text="—"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <TextBox x:Name="TxtEndTime"
                                         Grid.Column="2"
                                         Height="36"
                                         Padding="8"
                                         FontSize="12"
                                         BorderBrush="#CCCCCC"
                                         BorderThickness="1"
                                         Text="20:00"
                                         ToolTip="End time (e.g., 20:00)"/>
                            </Grid>

                            <!-- ERROR MESSAGE -->
                            <TextBlock x:Name="ErrorMessage"
                                       Text=""
                                       Foreground="#CC3333"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Visibility="Collapsed"
                                       Margin="0,0,0,15"/>

                            <!-- FINISH BUTTON -->
                            <Button Content="Finish"
                                    Click="FinishButton_Click"
                                    Height="42"
                                    Background="#222222"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontSize="14">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MATCHING ADS SECTION -->
                <Border x:Name="MatchingAdsSection"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="30"
                        Margin="0,30,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Matching Ads"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#222222"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="The following ads match your criteria (category and date range overlap):"
                                   FontSize="12"
                                   Foreground="#666666"
                                   Margin="0,0,0,15"/>

                        <!-- MATCHING ADS LIST -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="600">
                            <ItemsControl x:Name="MatchingAdsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                CornerRadius="10"
                                                Padding="18"
                                                BorderBrush="#CCCCCC"
                                                BorderThickness="1"
                                                Margin="0,0,0,15"
                                                Cursor="Hand"
                                                Tag="{Binding HelpAdId}"
                                                MouseLeftButtonUp="ScheduleButton_Click"
                                                ToolTip="Click to schedule an appointment">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- BADGES (offer/request + category) + TENANT NAME -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <Border Background="#FAFAFA"
                                                            BorderBrush="#333333"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8,4"
                                                            HorizontalAlignment="Stretch"
                                                            Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding TypeBadge}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="#222222"/>
                                                    </Border>

                                                    <Border Background="#FAFAFA"
                                                            BorderBrush="#333333"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8,4"
                                                            HorizontalAlignment="Stretch"
                                                            Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="#444444"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding TenantName}"
                                                               FontSize="11"
                                                               Foreground="#666666"
                                                               HorizontalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"/>
                                                </StackPanel>

                                                <!-- FREE APPOINTMENTS -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="Free appointments"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#222222"
                                                               Margin="0,0,0,6"/>
                                                    <TextBlock Text="{Binding FreeAppointments}"
                                                               FontSize="12"
                                                               Foreground="#444444"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- FROM / TO DATE RANGE -->
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="from:"
                                                                   FontSize="12"
                                                                   Foreground="#666666"
                                                                   VerticalAlignment="Center"
                                                                   Width="40"/>
                                                        <Border BorderBrush="#999999"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="6,3"
                                                                Background="White">
                                                            <TextBlock Text="{Binding StartDate, StringFormat='dd/MM/yyyy'}"
                                                                       FontSize="12"
                                                                       Foreground="#222222"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="to:"
                                                                   FontSize="12"
                                                                   Foreground="#666666"
                                                                   VerticalAlignment="Center"
                                                                   Width="40"/>
                                                        <Border BorderBrush="#999999"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="6,3"
                                                                Background="White">
                                                            <TextBlock Text="{Binding EndDate, StringFormat='dd/MM/yyyy'}"
                                                                       FontSize="12"
                                                                       Foreground="#222222"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- YELLOW STICKY NOTE COMMENT -->
                                                <Border Grid.Column="6"
                                                        Background="#FFD84D"
                                                        BorderBrush="#E6BE2E"
                                                        BorderThickness="1"
                                                        Padding="12"
                                                        MinHeight="110"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="12"
                                                               Foreground="#333333"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- CLOSE BUTTON -->
                        <Button Content="Close Matching Ads"
                                Click="CloseMatchingAdsButton_Click"
                                Height="32"
                                Background="#CCCCCC"
                                Foreground="#222222"
                                FontSize="12"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,15,0,0"
                                HorizontalAlignment="Right">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
