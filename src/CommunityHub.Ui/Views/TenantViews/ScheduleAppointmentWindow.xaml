<Window x:Class="CommunityHub.Ui.Views.TenantViews.ScheduleAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Appointment"
        Height="800"
        Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Homeowners"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,30" HorizontalAlignment="Center" Width="900">

                <!-- TITLE WITH BACK BUTTON -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="←" Background="Transparent" Foreground="#666"
                            FontSize="32" BorderThickness="0" Padding="0" Cursor="Hand"
                            Click="BackButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Grid.Column="1" Text="Schedule Your Appointment"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#222222"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- AD SUMMARY -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Margin="0,0,0,40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Background="#FAFAFA"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,10">
                                <TextBlock x:Name="TxtTypeBadge"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="#222222"/>
                            </Border>
                            <Border Background="#FAFAFA"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,10">
                                <TextBlock x:Name="TxtCategory"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Foreground="#444444"/>
                            </Border>
                            <TextBlock x:Name="TxtTenantName"
                                       FontSize="11"
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Termini"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#222222"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtFreeAppointmentTimes"
                                       Text="Učitavanje..."
                                       FontSize="12"
                                       Foreground="#444444"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="from:" FontSize="12" Foreground="#666666" VerticalAlignment="Center" Width="40"/>
                                <Border BorderBrush="#999999" BorderThickness="1" CornerRadius="3" Padding="6,3" Background="White">
                                    <TextBlock x:Name="TxtStartDate" FontSize="12" Foreground="#222222"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="to:" FontSize="12" Foreground="#666666" VerticalAlignment="Center" Width="40"/>
                                <Border BorderBrush="#999999" BorderThickness="1" CornerRadius="3" Padding="6,3" Background="White">
                                    <TextBlock x:Name="TxtEndDate" FontSize="12" Foreground="#222222"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="6"
                                Background="#FFD84D"
                                BorderBrush="#E6BE2E"
                                BorderThickness="1"
                                Padding="12"
                                MinHeight="110"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDescription"
                                       FontSize="12"
                                       Foreground="#333333"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- CHOOSE DATE + FREE APPOINTMENTS -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CHOOSE DATE -->
                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="Choose date:"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#222222"
                                   Margin="0,0,0,20"/>
                        <DatePicker x:Name="DpAppointmentDate"
                                    Height="36"
                                    Padding="8"
                                    FontSize="13"
                                    SelectedDateChanged="DpAppointmentDate_SelectedDateChanged"/>
                    </StackPanel>

                    <!-- CHOOSE TIME SLOT -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Choose from free appointments:"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#222222"
                                   Margin="0,0,0,20"/>
                        <StackPanel x:Name="SlotsPanel"/>
                        <TextBlock x:Name="NoSlotsMessage"
                                   Text="No free slots for the selected date."
                                   FontSize="13"
                                   Foreground="#888888"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- ERROR MESSAGE -->
                <TextBlock x:Name="ErrorMessage"
                           Text=""
                           Foreground="#CC3333"
                           TextWrapping="Wrap"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0,0,0,15"/>

                <!-- SUBMIT BUTTON -->
                <Button Content="SUBMIT"
                        Click="SubmitButton_Click"
                        Width="180"
                        Height="44"
                        Background="#222222"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
