<Window x:Class="CommunityHub.Ui.Views.TenantViews.MyAdsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Ads"
        Height="800"
        Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Homeowners"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDEBAR -->
                    <StackPanel Grid.Column="0">
                        <Border Background="White"
                                CornerRadius="10"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                Padding="15"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <!-- SORT BY TITLE -->
                                <TextBlock Text="Sort by:"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"
                                           FontSize="13"
                                           Foreground="#222222"/>

                                <!-- TYPE FILTER -->
                                <StackPanel Margin="0,0,0,20">
                                    <RadioButton x:Name="RbFilterAll"
                                                 Content="All"
                                                 IsChecked="True"
                                                 Margin="0,0,0,6"
                                                 Checked="RbFilterType_Changed"/>
                                    <RadioButton x:Name="RbFilterOffers"
                                                 Content="Offers"
                                                 Margin="0,0,0,6"
                                                 Checked="RbFilterType_Changed"/>
                                    <RadioButton x:Name="RbFilterRequests"
                                                 Content="Requests"
                                                 Margin="0,0,0,6"
                                                 Checked="RbFilterType_Changed"/>
                                </StackPanel>

                                <!-- CATEGORY FILTER -->
                                <TextBlock Text="Category"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           FontSize="13"
                                           Foreground="#222222"/>

                                <ComboBox x:Name="CbFilterCategory"
                                          Height="32"
                                          Margin="0,0,0,20"
                                          Padding="8,4"
                                          SelectionChanged="CbFilterCategory_SelectionChanged">
                                    <ComboBoxItem>All</ComboBoxItem>
                                    <ComboBoxItem>Moving</ComboBoxItem>
                                    <ComboBoxItem>Repairs</ComboBoxItem>
                                    <ComboBoxItem>Borrowing</ComboBoxItem>
                                    <ComboBoxItem>Cleaning</ComboBoxItem>
                                    <ComboBoxItem>Gardening</ComboBoxItem>
                                    <ComboBoxItem>Other</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- NOTIFICATIONS BUTTON -->
                        <Button Content="Notifications"
                                Width="170"
                                Height="36"
                                Background="White"
                                Foreground="#222222"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Click="NotificationsButton_Click"
                                Cursor="Hand"
                                Margin="0,0,0,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- CREATE AN AD BUTTON -->
                        <Button Content="Create an ad"
                                Width="170"
                                Height="36"
                                Background="White"
                                Foreground="#222222"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Click="CreateAdButton_Click"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- ADS LIST -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MyAdsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            CornerRadius="10"
                                            Padding="18"
                                            BorderBrush="#CCCCCC"
                                            BorderThickness="2"
                                            Margin="0,0,0,15"
                                            Cursor="Hand"
                                            Tag="{Binding Id}"
                                            MouseLeftButtonUp="AdItem_Click"
                                            x:Name="AdBorder">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- BADGES (offer/request + category) -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <Border Background="#FAFAFA"
                                                        BorderBrush="#333333"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding TypeBadge}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Foreground="#222222"/>
                                                </Border>

                                                <Border Background="#FAFAFA"
                                                        BorderBrush="#333333"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               Foreground="#444444"/>
                                                </Border>

                                                <TextBlock x:Name="StatusText" Text="{Binding Status}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <!-- FREE APPOINTMENTS -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Free appointments"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#222222"
                                                           Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding WorkingHours}"
                                                           FontSize="12"
                                                           Foreground="#444444"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- FROM / TO DATE RANGE -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="from:"
                                                               FontSize="12"
                                                               Foreground="#666666"
                                                               VerticalAlignment="Center"
                                                               Width="40"/>
                                                    <Border BorderBrush="#999999"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="6,3"
                                                            Background="White">
                                                        <TextBlock Text="{Binding StartDate, StringFormat='dd/MM/yyyy'}"
                                                                   FontSize="12"
                                                                   Foreground="#222222"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="to:"
                                                               FontSize="12"
                                                               Foreground="#666666"
                                                               VerticalAlignment="Center"
                                                               Width="40"/>
                                                    <Border BorderBrush="#999999"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="6,3"
                                                            Background="White">
                                                        <TextBlock Text="{Binding EndDate, StringFormat='dd/MM/yyyy'}"
                                                                   FontSize="12"
                                                                   Foreground="#222222"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- YELLOW STICKY NOTE COMMENT -->
                                            <Border Grid.Column="6"
                                                    Background="#FFD84D"
                                                    BorderBrush="#E6BE2E"
                                                    BorderThickness="1"
                                                    Padding="12"
                                                    MinHeight="110"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12"
                                                           Foreground="#333333"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ARCHIVE BUTTON (Top Right) -->
                    <Button Grid.Column="3"
                            Content="Archive"
                            Height="36"
                            Width="80"
                            Background="White"
                            Foreground="#CC3333"
                            BorderBrush="#CC3333"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            FontSize="11"
                            Click="ArchiveButton_Click"
                            Cursor="Hand"
                            VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- EMPTY STATE -->
                <TextBlock x:Name="EmptyStateMessage"
                           Text="You have no ads yet. Create one!"
                           FontSize="16"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
