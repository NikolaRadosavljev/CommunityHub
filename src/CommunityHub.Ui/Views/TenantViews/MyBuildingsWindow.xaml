<Window x:Class="CommunityHub.Ui.Views.TenantViews.MyBuildingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Buildings"
        Height="800"
        Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#222" FontWeight="SemiBold"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button x:Name="LogoutButton" Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- TOOLBAR - EMPTY FOR NOW -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- EMPTY STATE MESSAGE -->
                <TextBlock x:Name="EmptyStateMessage"
                           Text="You are not a member of any buildings yet."
                           FontSize="16"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0,300,0,0"/>

                <!-- BUILDINGS LIST - TWO COLUMNS -->
                <ItemsControl x:Name="MyBuildingsListControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Width="1300"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    CornerRadius="10"
                                    Padding="20"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    Margin="0,0,20,20"
                                    Width="580"
                                    MouseLeftButtonUp="BuildingCard_Click"
                                    Tag="{Binding Id}"
                                    Cursor="Hand">
                                <StackPanel>
                                    <!-- TITLE -->
                                    <TextBlock Text="{Binding Address}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#222222"
                                               Margin="0,0,0,15"/>

                                    <!-- PHOTO + INFO + CHART ROW -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- BUILDING PHOTO -->
                                        <Border Grid.Column="0"
                                                CornerRadius="6"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Image Source="{Binding MainPicture}" Height="140" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- INFO (Address, Date, Flat Number) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <!-- Address, Settlement, City -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Text="📍" FontSize="14" Margin="0,2,8,0"/>
                                                <StackPanel VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Address}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#222222"
                                                               Margin="0,0,0,2"/>
                                                    <TextBlock FontSize="11"
                                                               Foreground="#666666"
                                                               Margin="0,0,0,0">
                                                        <Run Text="{Binding Settlement}"/><Run Text=", "/><Run Text="{Binding City}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Date Created -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Text="📅" FontSize="14" Margin="0,2,8,0"/>
                                                <TextBlock Text="12/05/2025"
                                                           FontSize="12"
                                                           Foreground="#666666"/>
                                            </StackPanel>

                                            <!-- Flat Number -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏠" FontSize="14" Margin="0,2,8,0"/>
                                                <TextBlock Text="{Binding FlatNumberForTenant}"
                                                           FontSize="12"
                                                           Foreground="#666666"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- OCCUPANCY PIE CHART -->
                                        <Border Grid.Column="4" VerticalAlignment="Top">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="occupancy of the building"
                                                           FontSize="11"
                                                           Foreground="#666666"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,12"
                                                           TextAlignment="Center"
                                                           Width="150"/>

                                                <!-- Pie Chart using Canvas with Path -->
                                                <Canvas Width="120" Height="120" HorizontalAlignment="Center">
                                                    <!-- Light blue background circle -->
                                                    <Ellipse Canvas.Left="10" Canvas.Top="10"
                                                             Width="100" Height="100"
                                                             Fill="#ADD8E6"/>

                                                    <!-- Dark blue occupancy segment - Path geometry -->
                                                    <Path Canvas.Left="10" Canvas.Top="10"
                                                          Data="{Binding PieChartPathData}"
                                                          Fill="#003366"/>
                                                </Canvas>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- VIEW ADS BUTTON -->
                                    <Button Content="View ads"
                                            Tag="{Binding Id}"
                                            Click="ViewAdsButton_Click"
                                            Height="36"
                                            Background="White"
                                            Foreground="#222222"
                                            FontWeight="SemiBold"
                                            FontSize="12"
                                            BorderBrush="#333333"
                                            BorderThickness="2"
                                            Cursor="Hand"
                                            HorizontalAlignment="Center"
                                            Width="120">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
