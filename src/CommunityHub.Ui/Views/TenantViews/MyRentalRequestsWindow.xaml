<Window x:Class="CommunityHub.Ui.Views.TenantViews.MyRentalRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommunityHub.Ui.Converters"
        Title="My Rental Requests" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized">
    <Window.Resources>
        <local:RentalTypeConverter x:Key="RentalTypeConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#222" FontWeight="SemiBold"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Homeowners"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2" Margin="20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- REQUESTS LIST -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Width="Auto" Height="Auto">
                <ItemsControl x:Name="RequestsListView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="4" Padding="30" Margin="0,0,0,25"
                                    BorderBrush="#CCCCCC" BorderThickness="1"
                                    MouseLeftButtonDown="RequestItem_Click" Tag="{Binding Id}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- ROOM NAME -->
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding CommonRoomName}" FontSize="18" FontWeight="Bold" Foreground="#222" VerticalAlignment="Top"/>

                                    <!-- RENTAL TYPE -->
                                    <TextBlock Grid.Column="0" Grid.Row="1" Foreground="#666" Margin="0,5,0,0" FontSize="11"
                                               Text="{Binding RentalType, Converter={StaticResource RentalTypeConverter}, StringFormat='Rented for: {0}'}"/>

                                    <!-- SUGGESTED TERM (only if status is Pending - Term Change) -->
                                    <StackPanel Grid.Column="0" Grid.Row="2" Visibility="{Binding SuggestedStartDate, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,10,0,0">
                                        <TextBlock FontSize="10" Foreground="#999" Margin="0,0,0,2">
                                            <Run Text="Ponuđeni termin:"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#0066CC">
                                            <Run Text="{Binding SuggestedStartDate, StringFormat='dd/MM/yyyy'}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding SuggestedEndDate, StringFormat='dd/MM/yyyy'}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- DATES -->
                                    <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Top">
                                        <TextBlock FontSize="11" Foreground="#999" Margin="0,0,0,3">
                                            <Run Text="date,"/>
                                            <Run Text="time"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#333">
                                            <Run Text="{Binding StartDate, StringFormat='dd/MM/yyyy'}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding EndDate, StringFormat='dd/MM/yyyy'}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- FLOOR -->
                                    <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Floor, StringFormat='floor {0}'}" FontSize="12" Foreground="#333" VerticalAlignment="Top"/>

                                    <!-- STATUS -->
                                    <TextBlock Grid.Column="3" Grid.Row="0" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="#222" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- SIDE BUTTONS -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="30,0,0,0">
                <Button Content="Withdraw Pending&#10;Request"
                       Click="CancelRequestButton_Click"
                       Height="55" Width="170"
                       Background="White" Foreground="#222"
                       FontWeight="SemiBold" FontSize="11"
                       BorderBrush="#222222" BorderThickness="1"
                       Cursor="Hand" Padding="10" Margin="0,0,0,15">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Accept Suggested&#10;Dates"
                       Click="AcceptDatesButton_Click"
                       Height="55" Width="170"
                       Background="White" Foreground="#222"
                       FontWeight="SemiBold" FontSize="11"
                       BorderBrush="#009933" BorderThickness="2"
                       Cursor="Hand" Padding="10"
                       Visibility="{Binding SuggestedStartDate, Converter={StaticResource NullToVisibilityConverter}}"
                       Tag="{Binding Id}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
