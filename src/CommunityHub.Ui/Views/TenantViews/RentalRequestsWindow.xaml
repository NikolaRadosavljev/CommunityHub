<Window x:Class="CommunityHub.Ui.Views.TenantViews.RentalRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommunityHub.Ui.Converters"
        Title="Renting Common Rooms" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized">
    <Window.Resources>
        <local:RentalTypeToVisibilityConverter x:Key="RentalTypeConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#222" FontWeight="SemiBold"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Homeowners"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2" Margin="20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    BorderBrush="#DDDDDD" BorderThickness="1"
                    Margin="0,0,15,0" Padding="15" VerticalAlignment="Top">
                <StackPanel>
                    <Button Content="See your requests"
                           Click="SeeRequestsButton_Click"
                           Height="40"
                           Background="#222222" Foreground="White"
                           FontWeight="SemiBold" FontSize="12"
                           BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- MAIN AREA WITH SCROLL -->
            <StackPanel Grid.Column="1">
                <!-- BUILDING SELECTION -->
                <StackPanel x:Name="BuildingSelectionPanel" Margin="0,0,0,15">
                    <TextBlock Text="Select Building:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox x:Name="BuildingComboBox" Height="36" Padding="10,8" Width="300"
                             DisplayMemberPath="Address"
                             SelectedValuePath="Id"
                             SelectionChanged="BuildingComboBox_SelectionChanged"/>
                </StackPanel>

                <!-- COMMON ROOMS LIST WITH SCROLL -->
                <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" MaxHeight="500">
                    <ItemsControl x:Name="CommonRoomsListView">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="15" Margin="0,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- NAME -->
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#222" VerticalAlignment="Center"/>

                                        <!-- DESCRIPTION -->
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" Foreground="#666" TextWrapping="Wrap" MaxHeight="40" VerticalAlignment="Center"/>

                                        <!-- FLOOR -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Floor" FontSize="10" Foreground="#999" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Floor}" FontSize="11" Foreground="#666" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- RENTAL TYPE + DATE PICKER -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RentalTypeDisplay}" FontSize="11" Foreground="#666" Margin="0,0,0,8"/>

                                            <!-- Single Day -->
                                            <DatePicker x:Name="StartDatePicker" Height="30" Padding="8" FontSize="11"
                                                       Tag="{Binding Id}"/>

                                            <!-- Multiple Days - End Date -->
                                            <StackPanel Visibility="{Binding RentalType, Converter={StaticResource RentalTypeConverter}, ConverterParameter=MultipleDays}" Margin="0,8,0,0">
                                                <TextBlock Text="End date:" FontSize="10" Foreground="#999" Margin="0,0,0,4"/>
                                                <DatePicker x:Name="EndDatePicker" Height="30" Padding="8" FontSize="11"
                                                           Tag="{Binding Id}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- SEND REQUEST BUTTON -->
                                        <Button Grid.Column="4" Content="Send request"
                                               Tag="{Binding Id}"
                                               Click="SendRequestButton_Click"
                                               Height="36" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Background="#222222" Foreground="White"
                                               FontWeight="SemiBold" FontSize="11"
                                               BorderThickness="0" Cursor="Hand" Padding="12,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
