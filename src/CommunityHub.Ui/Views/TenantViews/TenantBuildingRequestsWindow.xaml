<Window x:Class="CommunityHub.Ui.Views.TenantViews.TenantBuildingRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.TenantViews"
        Title="Requests"
        Height="800"
        Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized">

    <Window.Resources>
        <local:OccupancyToPathConverter x:Key="OccupancyToPathConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#222" FontWeight="SemiBold"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- FILTER TOOLBAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <Button Content="Withdraw Pending Request"
                        Click="WithdrawSelectedButton_Click"
                        Height="32"
                        Padding="12,0"
                        Background="White"
                        Foreground="#222222"
                        FontWeight="SemiBold"
                        FontSize="11"
                        BorderBrush="#333333"
                        BorderThickness="2"
                        Cursor="Hand"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Filter by:" FontSize="11" FontWeight="SemiBold" Foreground="#666" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <StackPanel Margin="0,0,25,0">
                        <TextBlock Text="Status" FontSize="10" Foreground="#999" Margin="0,0,0,2"/>
                        <ComboBox x:Name="StatusFilterComboBox" Width="100" Height="26" Padding="6,4" SelectionChanged="FilterComboBox_SelectionChanged" FontSize="11">
                            <ComboBoxItem>All</ComboBoxItem>
                            <ComboBoxItem>Pending</ComboBoxItem>
                            <ComboBoxItem>Accepted</ComboBoxItem>
                            <ComboBoxItem>Denied</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Text="Sort by date:" FontSize="11" FontWeight="SemiBold" Foreground="#666" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Order" FontSize="10" Foreground="#999" Margin="0,0,0,2"/>
                        <ComboBox x:Name="SortDirectionComboBox" Width="100" Height="26" Padding="6,4" SelectionChanged="FilterComboBox_SelectionChanged" FontSize="11">
                            <ComboBoxItem>Newest</ComboBoxItem>
                            <ComboBoxItem>Oldest</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="20">
            <ItemsControl x:Name="RequestsListView">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,0,20"
                                MouseLeftButtonUp="RequestCard_Click"
                                Tag="{Binding Id}"
                                Cursor="Hand">
                            <StackPanel>
                                <!-- STATUS BADGE -->
                                <Grid Margin="0,0,0,15" Height="28">
                                    <Border Background="#90EE90" Padding="12,6" CornerRadius="6" Visibility="{Binding AcceptedVisibility}" Width="Auto" HorizontalAlignment="Left">
                                        <TextBlock Text="ACCEPTED" FontSize="12" Foreground="#006400" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#FFB6C6" Padding="12,6" CornerRadius="6" Visibility="{Binding DeniedVisibility}" Width="Auto" HorizontalAlignment="Left">
                                        <TextBlock Text="DENIED" FontSize="12" Foreground="#8B0000" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#FFFFE0" Padding="12,6" CornerRadius="6" Visibility="{Binding PendingVisibility}" BorderBrush="#DAA520" BorderThickness="2" Width="Auto" HorizontalAlignment="Left">
                                        <TextBlock Text="PENDING" FontSize="12" Foreground="#DAA520" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <!-- PHOTO + INFO + CHART ROW -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- BUILDING PHOTO -->
                                    <Border Grid.Column="0"
                                            CornerRadius="6"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Image Source="{Binding BuildingPhotoUrl}" Height="140" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- INFO (Address, Date, Flat Number) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <!-- Address, Settlement, City, Country -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="📍" FontSize="14" Margin="0,2,8,0"/>
                                            <StackPanel VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Address}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#222222"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="#666666">
                                                    <Run Text="{Binding Location}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Date Created -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="📅" FontSize="14" Margin="0,2,8,0"/>
                                            <TextBlock FontSize="12"
                                                       Foreground="#666666">
                                                <Run Text="Date the request was created: "/>
                                                <Run Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Flat Number -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🏠" FontSize="14" Margin="0,2,8,0"/>
                                            <TextBlock FontSize="12"
                                                       Foreground="#666666">
                                                <Run Text="Flat number: "/>
                                                <Run Text="{Binding FlatNumber}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- OCCUPANCY PIE CHART -->
                                    <Border Grid.Column="4" VerticalAlignment="Top">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="occupancy of the building"
                                                       FontSize="11"
                                                       Foreground="#666666"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,12"
                                                       TextAlignment="Center"
                                                       Width="150"/>

                                            <!-- Pie Chart using Canvas with Path -->
                                            <Canvas Width="120" Height="120" HorizontalAlignment="Center">
                                                <!-- Light blue background circle -->
                                                <Ellipse Canvas.Left="10" Canvas.Top="10"
                                                         Width="100" Height="100"
                                                         Fill="#ADD8E6"/>

                                                <!-- Dark blue occupancy segment - Path geometry -->
                                                <Path Canvas.Left="10" Canvas.Top="10"
                                                      Data="{Binding PieChartPathData}"
                                                      Fill="#003366"/>
                                            </Canvas>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
