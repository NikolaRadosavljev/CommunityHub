<Window x:Class="CommunityHub.Ui.Views.TenantViews.HomeownersMeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.TenantViews"
        Title="Homeowners Association"
        Height="800"
        Width="1400"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized">

    <Window.Resources>
        <local:StatusConverter x:Key="StatusConverter"/>
        <local:DateToEnglishConverter x:Key="DateConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#222" FontWeight="SemiBold"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Homeowners"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2" Margin="40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE: BUILDING SELECTION -->
            <StackPanel Grid.Column="0" Margin="0,0,0,0">
                <TextBlock Text="Buildings:"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#222222"
                           Margin="0,0,0,15"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="600">
                    <ItemsControl x:Name="BuildingsListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Address}"
                                            Margin="0,0,0,10"
                                            GroupName="BuildingGroup"
                                            Tag="{Binding Id}"
                                            Checked="BuildingRadioButton_Checked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- RIGHT SIDE: UNIFIED MEETING DETAILS -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="2,-160,0,0">
                <StackPanel x:Name="DetailsPanel" Margin="20,0,0,0">
                    <!-- Empty State -->
                    <TextBlock x:Name="EmptyDetailsMessage" Text="Select a building and meeting to view details."
                               FontSize="14" Foreground="#999" HorizontalAlignment="Center"
                               Visibility="Visible" Margin="0,200,0,0"/>

                    <!-- Meetings List -->
                    <ItemsControl x:Name="MeetingsListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="20" Margin="0,0,0,20" MouseLeftButtonDown="MeetingItem_Click" Tag="{Binding Id}" Cursor="Hand" Loaded="MeetingBorder_Loaded">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- TOP ROW: Main content -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- LEFT: Date & Time -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding ScheduledDate, Converter={StaticResource DateConverter}}"
                                                          FontSize="13" FontWeight="Bold" Foreground="#222" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ScheduledTime, StringFormat=hh\\:mm}"
                                                          FontSize="14" FontWeight="Bold" Foreground="#666" Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <!-- Topics List -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,5,0,0">
                                                <TextBlock Text="Topics:" FontSize="16" FontWeight="Bold" Foreground="#555" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding Topics}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding TopicText}" FontSize="16" Foreground="#222" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- MIDDLE: Status -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusConverter}}"
                                                          FontSize="12" FontWeight="SemiBold" Foreground="#222"
                                                          HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding AttendancePercentage, StringFormat=Attendance: {0:F0}%}"
                                                          FontSize="10" Foreground="#666" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <!-- Topic Suggestions -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-20,0,0,0">
                                                <TextBlock Text="Topic suggestions" FontSize="16" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                                <TextBox x:Name="ProposedTopicInput" Height="35" Width="160" Padding="8" TextWrapping="Wrap"
                                                        AcceptsReturn="True" Margin="0,0,0,6" FontSize="16"/>
                                                <Button Content="SEND" Height="28" Background="#2196F3" Foreground="White"
                                                       Cursor="Hand" Click="ProposeTopic_Click" FontSize="9" HorizontalAlignment="Center" Width="75"/>
                                            </StackPanel>

                                            <!-- RIGHT: Attendance Buttons -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                                <Button x:Name="ReportAttendanceButton" Content="Report attendance" Height="32"
                                                       Padding="8,0" Background="#4CAF50" Foreground="White" Cursor="Hand"
                                                       Click="ReportAttendance_Click" FontSize="9" Margin="0,0,0,6"/>
                                                <Button x:Name="CancelAttendanceButton" Content="Cancel attendance" Height="32"
                                                       Padding="8,0" Background="#FF9800" Foreground="White" Cursor="Hand"
                                                       Click="CancelAttendance_Click" FontSize="9" Margin="0,0,0,6"/>
                                                <Button x:Name="ClearSelectionButton" Content="Clear" Height="28"
                                                       Background="#999" Foreground="White" Cursor="Hand"
                                                       Click="ClearSelection_Click" FontSize="9"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- BOTTOM ROW: PIE CHART -->
                                        <Grid Grid.Row="1" Height="130" Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <Canvas Width="120" Height="120" HorizontalAlignment="Center">
                                                    <Ellipse Canvas.Left="10" Canvas.Top="10"
                                                             Width="100" Height="100"
                                                             Fill="#ADD8E6"/>
                                                    <Path x:Name="AttendanceSegment" Canvas.Left="10" Canvas.Top="10"
                                                          Fill="#003366"/>
                                                </Canvas>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                                <TextBlock Text="Attendance Overview" FontSize="12" FontWeight="Bold" Foreground="#555" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding AttendanceCount, StringFormat='Confirmations: {0}'}" FontSize="11" Foreground="#222" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding TotalStans, StringFormat='Total flats: {0}'}" FontSize="11" Foreground="#222"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyMeetingsMessage" Text="No meetings scheduled for this building."
                               FontSize="12" Foreground="#999" HorizontalAlignment="Center"
                               Visibility="Collapsed" Margin="0,50,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
