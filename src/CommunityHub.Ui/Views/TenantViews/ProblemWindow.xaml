<Window x:Class="CommunityHub.Ui.Views.TenantViews.ProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Problem Reporting"
        Height="800"
        Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Homeowners"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#222" FontWeight="SemiBold"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="40,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE: REPORT NEW PROBLEM -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="1" Padding="30" Margin="0,0,30,0">
                    <StackPanel>
                        <TextBlock Text="Report a new problem"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#222222"
                                   Margin="0,0,0,25"/>

                        <!-- CHOOSE BUILDING -->
                        <TextBlock Text="Choose building:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Margin="0,0,0,10"/>
                        <ComboBox x:Name="BuildingComboBox" Height="36" Padding="10,8" Margin="0,0,0,20"
                                 DisplayMemberPath="Address"
                                 SelectedValuePath="Id"
                                 SelectionChanged="BuildingComboBox_SelectionChanged"/>

                        <!-- RESOLUTION PRIORITY -->
                        <TextBlock Text="Resolution priority:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Margin="0,0,0,12"/>
                        <StackPanel Margin="0,0,0,20">
                            <RadioButton x:Name="RbCanWait" Content="can wait" Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbNeedsSoon" Content="needs to be solved in the next period" Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbUrgent" Content="urgent" Margin="0,0,0,8"/>
                        </StackPanel>

                        <!-- DESCRIPTION -->
                        <TextBlock Text="Description:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtDescription" Height="150" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                        <!-- SUBMIT BUTTON -->
                        <Button Content="SUBMIT" Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="SubmitButton_Click"/>

                        <!-- ERROR MESSAGE -->
                        <TextBlock x:Name="ErrorMessage" FontSize="12" Foreground="#CC3333" TextWrapping="Wrap" Margin="0,15,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT SIDE: REPORTED PROBLEMS -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Reported problems"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#222222"
                               Margin="0,0,0,20"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="650">
                        <ItemsControl x:Name="ProblemsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- BUILDING AND PRIORITY -->
                                            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding BuildingName}" FontSize="13" FontWeight="Bold" Foreground="#222222"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PriorityText}" FontSize="11" Foreground="#666666" FontStyle="Italic"/>
                                            </Grid>

                                            <!-- DESCRIPTION -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Description}" FontSize="12" Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,10" Background="#F9F9F9" Padding="10"/>

                                            <!-- STATUS -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Status:" FontSize="11" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#222222" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <!-- APPROVE/DISAPPROVE BUTTONS -->
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="ApproveButton" Content="Approve" Height="30" Padding="15,0" Background="#4CAF50" Foreground="White" Margin="0,0,8,0" Cursor="Hand" Click="ApproveButton_Click" Tag="{Binding Id}" Visibility="{Binding ApproveButtonVisibility}"/>
                                                <Button x:Name="DisapproveButton" Content="Disapproved" Height="30" Padding="15,0" Background="#CC3333" Foreground="White" Cursor="Hand" Click="DisapproveButton_Click" Tag="{Binding Id}" Visibility="{Binding DisapproveButtonVisibility}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- EMPTY STATE -->
                    <TextBlock x:Name="EmptyProblemsMessage" Text="No problems reported yet." FontSize="14" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,300,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
