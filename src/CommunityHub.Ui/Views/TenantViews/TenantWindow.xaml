<Window x:Class="CommunityHub.Ui.Views.TenantViews.TenantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
        Title="BuildingApp" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        WindowStyle="ThreeDBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized">

	<Window.Resources>
		<converters:FlatsRangeConverter x:Key="FlatsRangeConverter"/>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="45"/>
			<RowDefinition Height="180"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- NAV BAR -->
		<Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
			<DockPanel VerticalAlignment="Center" Margin="20,0">
				<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
					<Button Content="Home" Background="Transparent" Foreground="#222" FontWeight="SemiBold"
							FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"/>
					<Button Content="My building" Background="Transparent" Foreground="#666"
							FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
							Click="MyBuildingButton_Click"/>
					<Button Content="Notice board" Background="Transparent" Foreground="#666"
							FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
							Click="NoticeBoardButton_Click"/>
					<Button Content="Requests" Background="Transparent" Foreground="#666"
							FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
							Click="RequestsButton_Click"/>
					<Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
							FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
							Click="RentingCommonRoomsButton_Click"/>
					<Button Content="Homeowners association" Background="Transparent" Foreground="#666"
							FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
							Click="HomeownersAssociationButton_Click"/>
					<Button Content="Problem" Background="Transparent" Foreground="#666"
							FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
							Click="ProblemButton_Click"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
					<Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
					<Button x:Name="LogoutButton" Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- HEADER: Logo + Panorama -->
		<Grid Grid.Row="1" Background="White">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="230"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
				<Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
			</Border>

			<Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
		</Grid>

		<!-- MAIN CONTENT -->
		<Grid Grid.Row="2" Margin="20,15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="230"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- SIDEBAR -->
			<Border Grid.Column="0" Background="White" CornerRadius="10"
					BorderBrush="#DDDDDD" BorderThickness="1"
					Margin="0,0,15,0" Padding="15" VerticalAlignment="Top">
				<StackPanel>

					<!-- SEARCH BUTTON -->
					<Button x:Name="SearchButton" Height="40" Margin="0,0,0,15"
                            Click="SearchButton_Click" Background="#222222"
                            Foreground="White" FontWeight="SemiBold" FontSize="13"
                            BorderThickness="0" Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}" CornerRadius="6">
									<StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
										<TextBlock Text="🔍" Margin="0,0,8,0" VerticalAlignment="Center"/>
										<TextBlock Text="Search" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="White" VerticalAlignment="Center"/>
									</StackPanel>
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<!-- ADDRESS -->
					<Grid Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="26"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="📍" FontSize="15"
                                   VerticalAlignment="Center" Foreground="#777"/>
						<Grid Grid.Column="1">
							<TextBox x:Name="SearchAddressTextBox" Height="32" Padding="6,4"
                                     FontSize="12" BorderBrush="#CCCCCC" BorderThickness="1"
                                     Background="White" Foreground="#333"
                                     Tag="Address"
                                     GotFocus="Placeholder_GotFocus"
                                     LostFocus="Placeholder_LostFocus">
								<TextBox.Style>
									<Style TargetType="TextBox">
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="TextBox">
													<Border BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Background="{TemplateBinding Background}" CornerRadius="4">
														<ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</TextBox.Style>
							</TextBox>
							<TextBlock Text="Address" Foreground="#BBBBBB" FontSize="12"
                                       Padding="8,8,0,0" IsHitTestVisible="False">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding Text, ElementName=SearchAddressTextBox}" Value="">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</Grid>

					<!-- SETTLEMENT -->
					<Grid Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="26"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="🏘️" FontSize="15"
                                   VerticalAlignment="Center" Foreground="#777"/>
						<Grid Grid.Column="1">
							<TextBox x:Name="SearchSettlementTextBox" Height="32" Padding="6,4"
                                     FontSize="12" BorderBrush="#CCCCCC" BorderThickness="1"
                                     Background="White" Foreground="#333"
                                     Tag="Settlement"
                                     GotFocus="Placeholder_GotFocus"
                                     LostFocus="Placeholder_LostFocus">
								<TextBox.Style>
									<Style TargetType="TextBox">
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="TextBox">
													<Border BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Background="{TemplateBinding Background}" CornerRadius="4">
														<ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</TextBox.Style>
							</TextBox>
							<TextBlock Text="Settlement" Foreground="#BBBBBB" FontSize="12"
                                       Padding="8,8,0,0" IsHitTestVisible="False">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding Text, ElementName=SearchSettlementTextBox}" Value="">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</Grid>

					<!-- COUNTRY -->
					<Grid Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="26"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="🌍" FontSize="15"
                                   VerticalAlignment="Center" Foreground="#777"/>
						<Grid Grid.Column="1">
							<TextBox x:Name="SearchLocationTextBox" Height="32" Padding="6,4"
                                     FontSize="12" BorderBrush="#CCCCCC" BorderThickness="1"
                                     Background="White" Foreground="#333"
                                     Tag="Country"
                                     GotFocus="Placeholder_GotFocus"
                                     LostFocus="Placeholder_LostFocus">
								<TextBox.Style>
									<Style TargetType="TextBox">
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="TextBox">
													<Border BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Background="{TemplateBinding Background}" CornerRadius="4">
														<ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</TextBox.Style>
							</TextBox>
							<TextBlock Text="Country" Foreground="#BBBBBB" FontSize="12"
                                       Padding="8,8,0,0" IsHitTestVisible="False">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding Text, ElementName=SearchLocationTextBox}" Value="">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</Grid>

					<!-- CITY -->
					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="26"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="🏙️" FontSize="15"
                                   VerticalAlignment="Center" Foreground="#777"/>
						<Grid Grid.Column="1">
							<TextBox x:Name="SearchCityTextBox" Height="32" Padding="6,4"
                                     FontSize="12" BorderBrush="#CCCCCC" BorderThickness="1"
                                     Background="White" Foreground="#333"
                                     Tag="City"
                                     GotFocus="Placeholder_GotFocus"
                                     LostFocus="Placeholder_LostFocus">
								<TextBox.Style>
									<Style TargetType="TextBox">
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="TextBox">
													<Border BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Background="{TemplateBinding Background}" CornerRadius="4">
														<ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</TextBox.Style>
							</TextBox>
							<TextBlock Text="City" Foreground="#BBBBBB" FontSize="12"
                                       Padding="8,8,0,0" IsHitTestVisible="False">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding Text, ElementName=SearchCityTextBox}" Value="">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</Grid>

					<!-- VIEW ALL -->
					<Button x:Name="ViewAllButton" Content="View all" Height="36"
                            Background="White" Foreground="#222222"
                            FontWeight="SemiBold" FontSize="13"
                            BorderBrush="#AAAAAA" BorderThickness="1"
                            Cursor="Hand" Click="ViewAllButton_Click">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>

				</StackPanel>
			</Border>

			<!-- BUILDINGS LIST -->
			<ListView x:Name="BuildingsListView" Grid.Column="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      BorderThickness="0" Background="Transparent">
				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="Padding" Value="0"/>
						<Setter Property="Margin" Value="0,0,0,12"/>
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate>
						<Border Background="White" CornerRadius="10" Padding="15"
                                BorderBrush="#DDDDDD" BorderThickness="1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="150"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="160"/>
								</Grid.ColumnDefinitions>

								<!-- BUILDING PHOTO -->
								<Border Grid.Column="0" Width="130" Height="120"
                                        CornerRadius="8" BorderBrush="#DDDDDD"
                                        BorderThickness="1" ClipToBounds="True"
                                        Background="#F0F0F0">
									<Image Source="{Binding MainPicture}" Stretch="UniformToFill"/>
								</Border>

								<!-- BUILDING INFO -->
								<StackPanel Grid.Column="1" Margin="18,0,10,0"
                                            VerticalAlignment="Center" Orientation="Horizontal">

									<StackPanel Margin="0,0,15,0">
										<TextBlock Text="Address" Foreground="#999" FontSize="11" Margin="0,0,0,3"/>
										<TextBox Text="{Binding Address}" IsReadOnly="True"
                                                 Width="120" Height="30" Padding="6,4"
                                                 FontSize="12" Background="#F8F8F8"
                                                 BorderBrush="#E0E0E0" BorderThickness="1"/>
									</StackPanel>

									<StackPanel Margin="0,0,15,0">
										<TextBlock Text="Settlement" Foreground="#999" FontSize="11" Margin="0,0,0,3"/>
										<TextBox Text="{Binding Settlement}" IsReadOnly="True"
                                                 Width="120" Height="30" Padding="6,4"
                                                 FontSize="12" Background="#F8F8F8"
                                                 BorderBrush="#E0E0E0" BorderThickness="1"/>
									</StackPanel>

									<StackPanel Margin="0,0,15,0">
										<TextBlock Text="Number of floors" Foreground="#999" FontSize="11" Margin="0,0,0,3"/>
										<TextBox Text="{Binding FloorNumber}" IsReadOnly="True"
                                                 Width="100" Height="30" Padding="6,4"
                                                 FontSize="12" Background="#F8F8F8"
                                                 BorderBrush="#E0E0E0" BorderThickness="1"/>
									</StackPanel>

									<StackPanel>
										<TextBlock Text="Flat numbers" Foreground="#999" FontSize="11" Margin="0,0,0,3"/>
										<ComboBox x:Name="FlatNumberComboBox"
                                                  Width="110" Height="30"
                                                  Tag="{Binding Id}"
                                                  Loaded="FlatNumberComboBox_Loaded"
                                                  ItemsSource="{Binding FlatsRange, Converter={StaticResource FlatsRangeConverter}}"/>
									</StackPanel>

								</StackPanel>

								<!-- SEND REQUEST -->
								<StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
									<Button Content="Send request" Tag="{Binding Id}"
                                            Click="RequestAccessButton_Click"
                                            Height="40" Width="140"
                                            Background="#222222" Foreground="White"
                                            FontWeight="SemiBold" FontSize="12"
                                            BorderThickness="0" Cursor="Hand">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border Background="{TemplateBinding Background}" CornerRadius="6">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</ControlTemplate>
										</Button.Template>
									</Button>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<!-- Hidden elements for C# backend -->
			<StackPanel Visibility="Collapsed">
				<ComboBox x:Name="StatusFilterComboBox"/>
				<ComboBox x:Name="SortDirectionComboBox"/>
				<ListView x:Name="RequestsListView"/>
				<ListView x:Name="HelpAdsListView"/>
			</StackPanel>
		</Grid>
	</Grid>
</Window>
