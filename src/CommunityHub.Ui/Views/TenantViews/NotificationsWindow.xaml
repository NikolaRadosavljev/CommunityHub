<Window x:Class="CommunityHub.Ui.Views.TenantViews.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.TenantViews"
        Title="Notifications"
        Height="800"
        Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized">

    <Window.Resources>
        <local:NotificationColorConverter x:Key="NotificationColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Homeowners"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN CONTENT - MASTER DETAIL VIEW -->
        <Grid Grid.Row="2" Margin="20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: BUILDING SELECTION AND NOTIFICATIONS LIST -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BUILDING SELECTION -->
                <StackPanel Grid.Row="0" x:Name="BuildingSelectionPanel" Margin="0,0,0,20">
                    <TextBlock Text="Select Building:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox x:Name="BuildingComboBox" Height="36" Padding="10,8" Width="300"
                             DisplayMemberPath="Address"
                             SelectedValuePath="Id"
                             SelectionChanged="BuildingComboBox_SelectionChanged"/>
                </StackPanel>
                <!-- TITLE AND SORT -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="←" Background="Transparent" Foreground="#666"
                            FontSize="32" BorderThickness="0" Padding="0" Cursor="Hand"
                            Click="BackButton_Click" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="Notifications"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#222222"
                               Grid.Column="1"
                               VerticalAlignment="Center"/>

                    <!-- SORT BY TYPE -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filter:"
                                   FontSize="12"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <ComboBox x:Name="CbSortFilter"
                                  Width="140"
                                  Height="32"
                                  Padding="8,4"
                                  SelectionChanged="CbSortFilter_SelectionChanged">
                            <ComboBoxItem>All</ComboBoxItem>
                            <ComboBoxItem>Matching Ads</ComboBoxItem>
                            <ComboBoxItem>Offers</ComboBoxItem>
                            <ComboBoxItem>Requests</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- NOTIFICATIONS LIST -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NotificationsListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="8"
                                        Padding="15"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="1"
                                        Margin="0,0,0,12"
                                        MouseLeftButtonUp="NotificationItem_Click"
                                        Tag="{Binding Id}"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- NOTIFICATION ICON -->
                                        <TextBlock Grid.Column="0"
                                                   Text="🔔"
                                                   FontSize="18"
                                                   VerticalAlignment="Center"/>

                                        <!-- NOTIFICATION INFO -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NotificationTitle}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#222222"
                                                       Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding NotificationMessage}"
                                                       FontSize="11"
                                                       Foreground="{Binding IsMatchingAd, Converter={StaticResource NotificationColorConverter}}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- TIME -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding BookingTime, StringFormat='HH:mm'}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#222222"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <TextBlock x:Name="EmptyStateMessage"
                           Grid.Row="2"
                           Text="No notifications yet."
                           FontSize="16"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0,300,0,0"/>
            </Grid>

            <!-- RIGHT: DETAILS PANEL -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="20"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- DETAILS PANEL CONTENT -->
                    <StackPanel x:Name="DetailsPanel" Grid.Row="0" Visibility="Collapsed">
                        <!-- TITLE -->
                        <TextBlock Text="Busy Appointments"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#222222"
                                   Margin="0,0,0,20"/>

                        <!-- NOTIFICATION INFO -->
                        <Border Background="White"
                                CornerRadius="8"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Padding="15"
                                Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="🔔"
                                           FontSize="18"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailTitle"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#222222"
                                               Margin="0,0,0,3"/>
                                    <TextBlock x:Name="DetailMessage"
                                               FontSize="11"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Grid.Column="4"
                                           x:Name="DetailTime"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#222222"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- APPOINTMENT TIME DETAILS -->
                        <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="Appointment Details"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#666666"
                                       Margin="0,0,0,12"/>

                            <!-- DATE FIELD -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Date:"
                                           FontSize="11"
                                           Foreground="#666666"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           x:Name="DetailDate"
                                           FontSize="12"
                                           Foreground="#222222"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- TIME FIELD -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Time:"
                                           FontSize="11"
                                           Foreground="#666666"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           x:Name="DetailTimeValue"
                                           FontSize="12"
                                           Foreground="#222222"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- REQUESTING AD SECTION -->
                        <Border Background="#FFF9E6"
                                CornerRadius="8"
                                BorderBrush="#FFD84D"
                                BorderThickness="1"
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="Their Request:"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FF9800"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="DetailRequestingAd"
                                           FontSize="12"
                                           Foreground="#333333"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- EMPTY DETAILS STATE -->
                    <TextBlock x:Name="EmptyDetailsMessage"
                               Grid.Row="0"
                               Text="Select a notification to see appointment details"
                               FontSize="14"
                               Foreground="#999999"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
