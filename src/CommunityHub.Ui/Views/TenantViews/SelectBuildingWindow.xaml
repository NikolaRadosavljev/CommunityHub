<Window x:Class="CommunityHub.Ui.Views.TenantViews.SelectBuildingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Building" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0" Text="Select Your Building" FontSize="16" FontWeight="SemiBold"
                   Foreground="#222" Margin="0,0,0,20"/>

        <!-- BUILDINGS LIST -->
        <ListView x:Name="BuildingsListView" Grid.Row="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  BorderThickness="0" Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Button Tag="{Binding Id}" Click="BuildingButton_Click"
                            Background="White" Foreground="#222" BorderBrush="#DDDDDD"
                            BorderThickness="1" Cursor="Hand" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="15"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Address}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding Settlement}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="11" Foreground="#999" Text="{Binding City, StringFormat='City: {0}'}"/>
                                                <TextBlock FontSize="11" Foreground="#999" Text=" | " Margin="5,0"/>
                                                <TextBlock FontSize="11" Foreground="#999" Text="{Binding FloorNumber, StringFormat='Floors: {0}'}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="▶" FontSize="16" Foreground="#222"
                                                  VerticalAlignment="Center" Margin="15,0,0,0"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- CANCEL BUTTON -->
        <Button Grid.Row="2" Content="Cancel" Height="40" Width="120"
                HorizontalAlignment="Right"
                Background="White" Foreground="#222"
                FontWeight="SemiBold" FontSize="12"
                BorderBrush="#AAAAAA" BorderThickness="1"
                Cursor="Hand" Click="CancelButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
