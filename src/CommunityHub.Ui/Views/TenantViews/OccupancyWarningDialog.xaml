<Window x:Class="CommunityHub.Ui.Views.TenantViews.OccupancyWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warning"
        Height="350"
        Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <StackPanel Margin="30,40,30,30" VerticalAlignment="Top" HorizontalAlignment="Center">
        <!-- WARNING ICON -->
        <TextBlock Text="⚠"
                   FontSize="60"
                   Foreground="#FFA500"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- TITLE -->
        <TextBlock Text="The flat is already occupied,"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#222222"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- SUBTITLE -->
        <TextBlock Text="are you sure you want to submit a request?"
                   FontSize="14"
                   Foreground="#666666"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,40"/>

        <!-- BUTTONS -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0">
            <Button Content="YES"
                    Width="90"
                    Height="34"
                    Background="White"
                    Foreground="#333333"
                    BorderBrush="#999999"
                    BorderThickness="2"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Padding="0"
                    Click="YesButton_Click"/>

            <Button Content="Cancel"
                    Width="90"
                    Height="34"
                    Background="White"
                    Foreground="#333333"
                    BorderBrush="#999999"
                    BorderThickness="2"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Cursor="Hand"
                    Padding="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
