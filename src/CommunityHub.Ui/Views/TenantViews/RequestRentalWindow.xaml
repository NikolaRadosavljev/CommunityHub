<Window x:Class="CommunityHub.Ui.Views.TenantViews.RequestRentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Request Rental" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROOM NAME -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Common Room:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
            <TextBlock x:Name="RoomNameTextBlock" FontSize="11" Foreground="#666"/>
        </StackPanel>

        <!-- START DATE -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Start Date:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
            <DatePicker x:Name="StartDatePicker" Height="32" Padding="8"/>
        </StackPanel>

        <!-- END DATE -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="End Date:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
            <DatePicker x:Name="EndDatePicker" Height="32" Padding="8"/>
        </StackPanel>

        <!-- INFO MESSAGE -->
        <TextBlock Grid.Row="3" x:Name="InfoTextBlock" FontSize="11" Foreground="#CC3333"
                   TextWrapping="Wrap" Margin="0,0,0,15" Visibility="Collapsed"/>

        <!-- SPACER -->
        <Border Grid.Row="4"/>
        <Border Grid.Row="5"/>

        <!-- ACTION BUTTONS -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Height="40" Width="100"
                    Background="White" Foreground="#222"
                    FontWeight="SemiBold" FontSize="12"
                    BorderBrush="#AAAAAA" BorderThickness="1"
                    Cursor="Hand" Click="CancelButton_Click" Margin="0,0,10,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Request" Height="40" Width="100"
                    Background="#222222" Foreground="White"
                    FontWeight="SemiBold" FontSize="12"
                    BorderThickness="0" Cursor="Hand"
                    Click="SubmitButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
