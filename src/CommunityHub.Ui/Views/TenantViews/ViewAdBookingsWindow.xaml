<Window x:Class="CommunityHub.Ui.Views.TenantViews.ViewAdBookingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Booked Appointments"
        Height="800"
        Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="NoticeBoard"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Homeowners"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="NotificationButton" Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <!-- AD INFO -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Your Ad:" FontSize="14" FontWeight="SemiBold" Foreground="#222222" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtAdDescription" Text="" FontSize="13" Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock FontSize="12" Foreground="#666666">
                            <Run Text="Category: "/>
                            <Run x:Name="TxtCategory" Text=""/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- BOOKED SLOTS LIST -->
                <TextBlock Text="Reserved Time Slots" FontSize="16" FontWeight="SemiBold" Foreground="#222222" Margin="0,0,0,15"/>

                <ItemsControl x:Name="BookingsListControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    CornerRadius="10"
                                    Padding="18"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- TIME SLOT INFO -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Time Slot:" FontSize="12" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding SlotDateDisplay}" FontSize="13" Foreground="#222222" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SlotTimeDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,15"/>
                                        <TextBlock Text="{Binding TenantName}" FontSize="12" Foreground="#666666" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- REQUESTING AD INFO -->
                                    <Border Grid.Column="1" Background="#FFF9E6" BorderBrush="#FFD84D" BorderThickness="1" CornerRadius="6" Padding="15" Margin="15,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Their Request:" FontSize="12" FontWeight="SemiBold" Foreground="#FF9800" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding RequestingAdDescription}" FontSize="13" Foreground="#333333" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- EMPTY STATE -->
                <TextBlock x:Name="EmptyStateMessage"
                           Text="No booked appointments for this ad yet."
                           FontSize="14"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           Margin="0,50,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
