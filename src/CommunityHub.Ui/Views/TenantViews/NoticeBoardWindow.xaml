<Window x:Class="CommunityHub.Ui.Views.TenantViews.NoticeBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notice Board"
        Height="800"
        Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NAV BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Home" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Home"/>
                    <Button Content="My building" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="MyBuilding"/>
                    <Button Content="Notice board" Background="Transparent" Foreground="#222" FontWeight="SemiBold"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"/>
                    <Button Content="Requests" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Requests"/>
                    <Button Content="Renting common rooms" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="RentingRooms"/>
                    <Button Content="Homeowners association" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"/>
                    <Button Content="Problem" Background="Transparent" Foreground="#666"
                            FontSize="13" BorderThickness="0" Padding="12,0" Cursor="Hand"
                            Click="TabButton_Click" Tag="Problem"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="🔔" Background="Transparent" Foreground="#555"
                            FontSize="18" BorderThickness="0" Padding="8,4" Cursor="Hand"
                            Click="NotificationsButton_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Log out"
                            Background="Transparent" Foreground="#CC3333"
                            FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HEADER: Logo + Panorama -->
        <Grid Grid.Row="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/BuildingLogo.jpg"
                       Width="100" Height="100" Stretch="Uniform"/>
            </Border>

            <Image Grid.Column="1" Source="pack://application:,,,/PanoramaBuilding.jpg"
                   Height="180" Stretch="Fill" HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- TOOLBAR -->
        <Border x:Name="ToolbarBorder" Grid.Row="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Button Content="Create an ad"
                        Width="120"
                        Height="36"
                        Background="White"
                        Foreground="#222222"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Click="CreateAdButton_Click"
                        Cursor="Hand"
                        Margin="0,0,15,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="My Ads"
                        Width="120"
                        Height="36"
                        Background="White"
                        Foreground="#222222"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Click="YourAdsButton_Click"
                        Cursor="Hand"
                        Margin="0,0,15,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Notifications"
                        Width="120"
                        Height="36"
                        Background="White"
                        Foreground="#222222"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Click="NotificationsButton_Click"
                        Cursor="Hand"
                        Margin="0,0,15,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="3" Margin="20,0,20,20">
            <!-- BUILDING SELECTION PANEL (Initial View) -->
            <Grid x:Name="BuildingSelectionPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: BUILDING SELECTION -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="30">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Choose building:"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#222222"
                                   Margin="0,0,0,25"/>

                        <ComboBox x:Name="BuildingSelectionCombo"
                                  Height="42"
                                  Padding="12,10"
                                  FontSize="13"
                                  DisplayMemberPath="Address"
                                  SelectionChanged="BuildingSelectionCombo_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT: STATISTICS CHART -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Statistics:"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#222222"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Amount of ads"
                                       FontSize="12"
                                       Foreground="#666666"/>
                        </StackPanel>

                        <!-- BAR CHART -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <!-- Y-AXIS WITH BUILDING NAMES -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <ItemsControl x:Name="StatsChartLabels" Margin="0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BuildingAddress}"
                                                       FontSize="11"
                                                       Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"
                                                       Height="50"
                                                       VerticalAlignment="Bottom"
                                                       TextAlignment="Right"
                                                       Margin="0,0,10,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- BARS AREA -->
                            <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                <!-- Y-AXIS LINE -->
                                <Border Background="#333333" Width="2" HorizontalAlignment="Left"/>

                                <!-- BARS -->
                                <ItemsControl x:Name="StatsChart" Margin="10,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="50" VerticalAlignment="Bottom">
                                                <!-- Bar -->
                                                <Border Background="#7CB9E8"
                                                        Height="30"
                                                        VerticalAlignment="Bottom"
                                                        CornerRadius="3,3,0,0"
                                                        Width="{Binding BarWidth}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0"/>

                                                <!-- Value label on top of bar -->
                                                <TextBlock Text="{Binding AdCount}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#333333"
                                                           VerticalAlignment="Top"
                                                           Margin="0,5,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- X-AXIS -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom">
                                <Border Background="#333333" Height="2"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ADS CONTENT PANEL -->
            <Grid x:Name="AdsContentPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

            <!-- FILTER PANEL -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="15"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0">
                <StackPanel>
                    <!-- TYPE FILTER -->
                    <TextBlock Text="Type"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               FontSize="13"/>

                    <StackPanel Margin="0,0,0,20">
                        <RadioButton x:Name="RbFilterOffers"
                                     Content="Offers"
                                     Margin="0,0,0,6"
                                     Checked="RbFilterType_Changed"/>
                        <RadioButton x:Name="RbFilterRequests"
                                     Content="Requests"
                                     Margin="0,0,0,6"
                                     Checked="RbFilterType_Changed"/>
                        <RadioButton x:Name="RbFilterAll"
                                     Content="All"
                                     IsChecked="True"
                                     Checked="RbFilterType_Changed"/>
                    </StackPanel>

                    <!-- CATEGORY FILTER -->
                    <TextBlock Text="Category"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               FontSize="13"/>

                    <ComboBox x:Name="CbFilterCategory"
                              Height="32"
                              Margin="0,0,0,20"
                              Padding="8,4"
                              SelectionChanged="CbFilterCategory_SelectionChanged">
                        <ComboBoxItem>All</ComboBoxItem>
                        <ComboBoxItem>Moving</ComboBoxItem>
                        <ComboBoxItem>Repairs</ComboBoxItem>
                        <ComboBoxItem>Borrowing</ComboBoxItem>
                        <ComboBoxItem>Cleaning</ComboBoxItem>
                        <ComboBoxItem>Gardening</ComboBoxItem>
                        <ComboBoxItem>Other</ComboBoxItem>
                    </ComboBox>

                    <!-- DATE RANGE FILTER -->
                    <TextBlock Text="From:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"
                               FontSize="12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CbFromDay"
                                  Grid.Column="0"
                                  Height="28"
                                  Padding="4,2"
                                  Margin="0,0,5,0"
                                  SelectionChanged="OnDateFilterChanged">
                            <ComboBoxItem>1</ComboBoxItem>
                            <ComboBoxItem>2</ComboBoxItem>
                            <ComboBoxItem>3</ComboBoxItem>
                            <ComboBoxItem>4</ComboBoxItem>
                            <ComboBoxItem>5</ComboBoxItem>
                            <ComboBoxItem>6</ComboBoxItem>
                            <ComboBoxItem>7</ComboBoxItem>
                            <ComboBoxItem>8</ComboBoxItem>
                            <ComboBoxItem>9</ComboBoxItem>
                            <ComboBoxItem>10</ComboBoxItem>
                            <ComboBoxItem>11</ComboBoxItem>
                            <ComboBoxItem>12</ComboBoxItem>
                            <ComboBoxItem>13</ComboBoxItem>
                            <ComboBoxItem>14</ComboBoxItem>
                            <ComboBoxItem>15</ComboBoxItem>
                            <ComboBoxItem>16</ComboBoxItem>
                            <ComboBoxItem>17</ComboBoxItem>
                            <ComboBoxItem>18</ComboBoxItem>
                            <ComboBoxItem>19</ComboBoxItem>
                            <ComboBoxItem>20</ComboBoxItem>
                            <ComboBoxItem>21</ComboBoxItem>
                            <ComboBoxItem>22</ComboBoxItem>
                            <ComboBoxItem>23</ComboBoxItem>
                            <ComboBoxItem>24</ComboBoxItem>
                            <ComboBoxItem>25</ComboBoxItem>
                            <ComboBoxItem>26</ComboBoxItem>
                            <ComboBoxItem>27</ComboBoxItem>
                            <ComboBoxItem>28</ComboBoxItem>
                            <ComboBoxItem>29</ComboBoxItem>
                            <ComboBoxItem>30</ComboBoxItem>
                            <ComboBoxItem>31</ComboBoxItem>
                        </ComboBox>

                        <ComboBox x:Name="CbFromMonth"
                                  Grid.Column="1"
                                  Height="28"
                                  Padding="4,2"
                                  Margin="0,0,5,0"
                                  SelectionChanged="OnDateFilterChanged">
                            <ComboBoxItem>January</ComboBoxItem>
                            <ComboBoxItem>February</ComboBoxItem>
                            <ComboBoxItem>March</ComboBoxItem>
                            <ComboBoxItem>April</ComboBoxItem>
                            <ComboBoxItem>May</ComboBoxItem>
                            <ComboBoxItem>June</ComboBoxItem>
                            <ComboBoxItem>July</ComboBoxItem>
                            <ComboBoxItem>August</ComboBoxItem>
                            <ComboBoxItem>September</ComboBoxItem>
                            <ComboBoxItem>October</ComboBoxItem>
                            <ComboBoxItem>November</ComboBoxItem>
                            <ComboBoxItem>December</ComboBoxItem>
                        </ComboBox>

                        <ComboBox x:Name="CbFromYear"
                                  Grid.Column="2"
                                  Height="28"
                                  Padding="4,2"
                                  SelectionChanged="OnDateFilterChanged">
                            <ComboBoxItem>2024</ComboBoxItem>
                            <ComboBoxItem>2025</ComboBoxItem>
                            <ComboBoxItem>2026</ComboBoxItem>
                            <ComboBoxItem>2027</ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="To:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"
                               FontSize="12"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CbToDay"
                                  Grid.Column="0"
                                  Height="28"
                                  Padding="4,2"
                                  Margin="0,0,5,0"
                                  SelectionChanged="OnDateFilterChanged">
                            <ComboBoxItem>1</ComboBoxItem>
                            <ComboBoxItem>2</ComboBoxItem>
                            <ComboBoxItem>3</ComboBoxItem>
                            <ComboBoxItem>4</ComboBoxItem>
                            <ComboBoxItem>5</ComboBoxItem>
                            <ComboBoxItem>6</ComboBoxItem>
                            <ComboBoxItem>7</ComboBoxItem>
                            <ComboBoxItem>8</ComboBoxItem>
                            <ComboBoxItem>9</ComboBoxItem>
                            <ComboBoxItem>10</ComboBoxItem>
                            <ComboBoxItem>11</ComboBoxItem>
                            <ComboBoxItem>12</ComboBoxItem>
                            <ComboBoxItem>13</ComboBoxItem>
                            <ComboBoxItem>14</ComboBoxItem>
                            <ComboBoxItem>15</ComboBoxItem>
                            <ComboBoxItem>16</ComboBoxItem>
                            <ComboBoxItem>17</ComboBoxItem>
                            <ComboBoxItem>18</ComboBoxItem>
                            <ComboBoxItem>19</ComboBoxItem>
                            <ComboBoxItem>20</ComboBoxItem>
                            <ComboBoxItem>21</ComboBoxItem>
                            <ComboBoxItem>22</ComboBoxItem>
                            <ComboBoxItem>23</ComboBoxItem>
                            <ComboBoxItem>24</ComboBoxItem>
                            <ComboBoxItem>25</ComboBoxItem>
                            <ComboBoxItem>26</ComboBoxItem>
                            <ComboBoxItem>27</ComboBoxItem>
                            <ComboBoxItem>28</ComboBoxItem>
                            <ComboBoxItem>29</ComboBoxItem>
                            <ComboBoxItem>30</ComboBoxItem>
                            <ComboBoxItem>31</ComboBoxItem>
                        </ComboBox>

                        <ComboBox x:Name="CbToMonth"
                                  Grid.Column="1"
                                  Height="28"
                                  Padding="4,2"
                                  Margin="0,0,5,0"
                                  SelectionChanged="OnDateFilterChanged">
                            <ComboBoxItem>January</ComboBoxItem>
                            <ComboBoxItem>February</ComboBoxItem>
                            <ComboBoxItem>March</ComboBoxItem>
                            <ComboBoxItem>April</ComboBoxItem>
                            <ComboBoxItem>May</ComboBoxItem>
                            <ComboBoxItem>June</ComboBoxItem>
                            <ComboBoxItem>July</ComboBoxItem>
                            <ComboBoxItem>August</ComboBoxItem>
                            <ComboBoxItem>September</ComboBoxItem>
                            <ComboBoxItem>October</ComboBoxItem>
                            <ComboBoxItem>November</ComboBoxItem>
                            <ComboBoxItem>December</ComboBoxItem>
                        </ComboBox>

                        <ComboBox x:Name="CbToYear"
                                  Grid.Column="2"
                                  Height="28"
                                  Padding="4,2"
                                  SelectionChanged="OnDateFilterChanged">
                            <ComboBoxItem>2024</ComboBoxItem>
                            <ComboBoxItem>2025</ComboBoxItem>
                            <ComboBoxItem>2026</ComboBoxItem>
                            <ComboBoxItem>2027</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ADS LIST -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BUILDING SELECTOR -->
                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Choose building:"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#222222"
                                   Margin="0,0,0,10"/>
                        <ComboBox x:Name="BuildingSelector"
                                  Height="36"
                                  Padding="8,6"
                                  SelectionChanged="BuildingSelector_SelectionChanged"
                                  DisplayMemberPath="Address">
                        </ComboBox>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="HelpAdsListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="10"
                                        Padding="18"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="1"
                                        Margin="0,0,0,15"
                                        Cursor="Hand"
                                        Tag="{Binding Id}"
                                        MouseLeftButtonUp="AdCard_Click"
                                        ToolTip="Click to schedule an appointment">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- BADGES (offer/request + category) + TENANT NAME -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <Border Background="#FAFAFA"
                                                    BorderBrush="#333333"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,10">
                                                <TextBlock Text="{Binding TypeBadge}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#222222"/>
                                            </Border>

                                            <Border Background="#FAFAFA"
                                                    BorderBrush="#333333"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#444444"/>
                                            </Border>

                                            <TextBlock Text="{Binding TenantName}"
                                                       FontSize="11"
                                                       Foreground="#666666"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"/>
                                        </StackPanel>

                                        <!-- FREE APPOINTMENTS -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Free appointments"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#222222"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding FreeAppointments}"
                                                       FontSize="12"
                                                       Foreground="#444444"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- FROM / TO DATE RANGE -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="from:"
                                                           FontSize="12"
                                                           Foreground="#666666"
                                                           VerticalAlignment="Center"
                                                           Width="40"/>
                                                <Border BorderBrush="#999999"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="6,3"
                                                        Background="White">
                                                    <TextBlock Text="{Binding StartDate, StringFormat='dd/MM/yyyy'}"
                                                               FontSize="12"
                                                               Foreground="#222222"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="to:"
                                                           FontSize="12"
                                                           Foreground="#666666"
                                                           VerticalAlignment="Center"
                                                           Width="40"/>
                                                <Border BorderBrush="#999999"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="6,3"
                                                        Background="White">
                                                    <TextBlock Text="{Binding EndDate, StringFormat='dd/MM/yyyy'}"
                                                               FontSize="12"
                                                               Foreground="#222222"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- YELLOW STICKY NOTE COMMENT -->
                                        <Border Grid.Column="6"
                                                Background="#FFD84D"
                                                BorderBrush="#E6BE2E"
                                                BorderThickness="1"
                                                Padding="12"
                                                MinHeight="110"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="#333333"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <TextBlock Grid.Row="1"
                           x:Name="EmptyStateMessage"
                           Text="No active ads available."
                           FontSize="16"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0,300,0,0"/>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
